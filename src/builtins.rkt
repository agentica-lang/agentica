                    ("Int.shift_right" ((a Int) (count Int)) Int #f "Int.shift_right" () "Arithmetic shift right, copying the sign bit; a count of 64 or more gives 0 or -1; a negative count halts.")
                    ("Int.shift_right_unsigned" ((a Int) (count Int)) Int #f "Int.shift_right_unsigned" () "Logical shift right, bringing in zeros; a count of 64 or more gives 0; a negative count halts.")
                    ("Float.to_bits" ((x Float)) Int #f "Float.to_bits" () "The 64 IEEE 754 binary64 bits as an Int; every NaN gives the canonical 9221120237041090560.")
                    ("Float.from_bits" ((bits Int)) Float #f "Float.from_bits" () "Read the 64 bits of an Int as a binary64 Float; any NaN pattern gives NaN.")
                    ("Float.to_bits32" ((x Float)) Int #f "Float.to_bits32" () "Round to binary32 (ties to even) and give its 32 bits as an Int from 0 to 4294967295; every NaN gives 2143289344.")
                    ("Float.from_bits32" ((bits Int)) Float #f "Float.from_bits32" () "Read 32 bits as a binary32 and widen it exactly; bits outside 0 to 4294967295 halt.")
                    ("Time.now_ms" () Int #f "Time.now_ms" (clock) "Read wall-clock milliseconds since the Unix epoch; may jump.")
                    ("Time.monotonic_ms" () Int #f "Time.monotonic_ms" (clock) "Read milliseconds from an arbitrary origin that never goes backward; use for durations.")
                    ("Random.int" ((min Int) (max Int)) Int #f "Random.int" (random) "Pick a uniform Int in min..max inclusive; min > max halts.")
                    ("Random.float" () Float #f "Random.float" (random) "Pick a uniform Float in 0.0 up to, but not including, 1.0.")
                    ("ok" ((value T)) (Result T) ok "ok" () "Construct a successful Result.")
                    ("error" ((message String)) (Result T) error "error" () "Construct an error; needs an expected Result type.")
                    ("Result.ok?" ((r (Result T))) Bool result-ok "Result.ok?" () "Check whether a Result succeeded.")
                    ("Result.unwrap!" ((r (Result T))) T result-unwrap "Result.unwrap!" () "Return the success value; halt on error.")
                    ("Result.unwrap_or" ((r (Result T)) (default T)) T result-default "Result.unwrap_or" () "Return success or default; both arguments run eagerly.")
                    ("Result.message" ((r (Result T))) String result-message "Result.message" () "Return an error message, or empty text for success.")))])
    (define entry (apply builtin row))
    (when (equal? (builtin-name entry) "ok")
      (set-builtin-alternatives! entry
        (list (builtin "ok" '() '(Result Void) 'ok-void "ok" '() "Construct successful completion."))))
    (when (equal? (builtin-name entry) "Task.await")
      (set-builtin-alternatives!
       entry
       (list (builtin "Task.await" '((task (Task R)) (timeout_ms Int))
                      '(Await R) 'task-await-timeout "Task.await" '(concurrency)
                      "Wait for a task for at most timeout_ms; Await.Done(value) with its cached result, or Await.TimedOut, and the task keeps running; timeout_ms must be positive."))))
    (when (equal? (builtin-name entry) "Map.get")
      (set-builtin-alternatives!
       entry
       (list (builtin "Map.get" '((map (Map K V)) (key K) (default V))
                      'V 'map-get-default "Map.get" '() (builtin-description entry)))))
    (values (car row) entry)))

(define std-only-modules '("HttpWire"))

(define (std-only-name? name)
  (for/or ([module (in-list std-only-modules)])
    (string-prefix? name (string-append module "."))))

(define (public-builtin-names)
  (filter (lambda (name) (not (std-only-name? name))) (hash-keys builtins)))

(define (builtin-ref name [arity #f])
  (define entry (hash-ref builtins name #f))
  (if (and entry arity)
      (findf (lambda (variant) (= arity (length (builtin-parameters variant))))
             (cons entry (builtin-alternatives entry)))
      entry))

(define (edit-distance a b)
  (define n (string-length b))
  (define last-row (build-vector (add1 n) values))
  (for ([i (in-range 1 (add1 (string-length a)))])
    (define row (make-vector (add1 n) i))
    (for ([j (in-range 1 (add1 n))])
      (vector-set! row j
                   (min (add1 (vector-ref last-row j))
                        (add1 (vector-ref row (sub1 j)))
                        (+ (vector-ref last-row (sub1 j))
                           (if (char=? (string-ref a (sub1 i)) (string-ref b (sub1 j))) 0 1)))))
    (vector-copy! last-row 0 row))
  (vector-ref last-row n))

(define (name-prefix name)
  (car (or (regexp-match #rx"^@[0-9]+::" name) '(""))))

(define (did-you-mean full-name candidates #:shared [shared '()])
  (define prefix (name-prefix full-name))
  (define name (display-name full-name))
  (define limit (if (<= (string-length name) 4) 1 2))
  (define pool
    (append (for/list ([candidate (in-list candidates)]
                       #:when (string=? (name-prefix candidate) prefix))
              (display-name candidate))
            shared))
  (define near
    (sort (for/list ([candidate (in-list (remove-duplicates pool))]
                     #:unless (string=? candidate name)
                     #:when (<= (edit-distance name candidate) limit))
            candidate)
          (lambda (x y)
            (define dx (edit-distance name x))
            (define dy (edit-distance name y))
            (or (< dx dy) (and (= dx dy) (string<? x y))))))
  (and (pair? near) (format "did you mean \"~a\"?" (car near))))

(define (single-signature entry)
  (format "~a(~a) -> ~a" (builtin-name entry)
          (string-join
           (for/list ([parameter (in-list (builtin-parameters entry))])
             (format "~a: ~a" (car parameter) (type->string (cadr parameter)))) ", ")
          (type->string (builtin-result entry))))

(define (builtin-signature entry)
  (string-join (map single-signature (cons entry (builtin-alternatives entry))) "\n"))

(define (single-jsexpr entry)
  (hasheq 'name (builtin-name entry)
          'arity (length (builtin-parameters entry))
          'parameters (for/list ([parameter (in-list (builtin-parameters entry))])
                        (hasheq 'name (symbol->string (car parameter))
                                'type (type->string (cadr parameter))))
          'result (type->string (builtin-result entry))
          'signature (single-signature entry)
          'effects (map symbol->string (builtin-effects entry))
          'description (builtin-description entry)))

(define (builtin->jsexpr entry)
  (if (null? (builtin-alternatives entry))
      (single-jsexpr entry)
      (hasheq 'name (builtin-name entry)
              'description (builtin-description entry)
              'effects (map symbol->string (builtin-effects entry))
              'overloads (map single-jsexpr (cons entry (builtin-alternatives entry))))))
