#lang racket

(require "source.rkt" "diagnostic.rkt")

(provide parse-gherkin (struct-out feature) (struct-out scenario) (struct-out step))

(struct feature (name scenarios tags span) #:transparent)
(struct scenario (name steps tags span example-span) #:transparent)
(struct step (kind text doc table span) #:transparent)
(struct draft (name outline? steps examples tags span) #:mutable)
(struct example-row (span bindings tags) #:transparent)

(define (parse-gherkin input)
  (let/ec stop
    (define split-lines (string-split (source-text input) "\n" #:trim? #f))
    (define lines (list->vector (if (null? split-lines) '("") split-lines)))
    (define offsets (make-vector (vector-length lines)))
    (for/fold ([offset 0]) ([line (in-vector lines)] [i (in-naturals)])
      (vector-set! offsets i offset)
      (+ offset (string-length line) 1))
    (define cursor 0)
    (define title #f)
    (define title-span #f)
    (define feature-tags '())
    (define pending-tags '())
    (define background '())
    (define background? #f)
    (define current #f)
    (define cases '())
    (define mode #f)
    (define previous-kind #f)
    (define (raw [i cursor]) (string-trim (vector-ref lines i) "\r" #:left? #f))
    (define (text [i cursor]) (string-trim (raw i)))
    (define (location [i cursor])
      (define index (min i (sub1 (vector-length lines))))
      (source-span input (source-position (vector-ref offsets index) (add1 index) 1)
                   (source-position (+ (vector-ref offsets index) (string-length (raw index)))
                                    (add1 index) (add1 (string-length (raw index))))))
    (define (fail code message [where (location)])
      (stop (diagnostic code message where)))
    (define (advance!) (set! cursor (add1 cursor)))
    (define (active-steps)
      (if (eq? mode 'background) background (if current (draft-steps current) '())))
    (define (set-steps! value)
      (if (eq? mode 'background) (set! background value) (set-draft-steps! current value)))
    (define (attach! doc table)
      (unless (and (memq mode '(background scenario)) (null? pending-tags))
        (fail 'PARSE-GHERKIN-ARGUMENT "step argument is outside a step"))
      (define items (active-steps))
      (when (or (null? items) (step-doc (car items)) (step-table (car items)))
        (fail 'PARSE-GHERKIN-ARGUMENT "a step accepts one Doc String or Data Table"))
      (define last-step (car items))
      (set-steps! (cons (struct-copy step last-step [doc doc] [table table]) (cdr items))))
    (define (table-row)
      (define row (text))
      (unless (string-suffix? row "|")
        (fail 'PARSE-GHERKIN-TABLE "a table row must end with |"))
      (define cells '())
      (define cell (open-output-string))
      (define escaped? #f)
      (for ([ch (in-string (substring row 1))])
        (cond
          [escaped?
           (unless (memv ch '(#\n #\| #\\))
             (fail 'PARSE-GHERKIN-TABLE "invalid table escape"))
           (write-char (if (char=? ch #\n) #\newline ch) cell)
           (set! escaped? #f)]
          [(char=? ch #\\) (set! escaped? #t)]
          [(char=? ch #\|)
           (set! cells (cons (string-trim (get-output-string cell)) cells))
           (set! cell (open-output-string))]
          [else (write-char ch cell)]))
      (when escaped? (fail 'PARSE-GHERKIN-TABLE "unfinished table escape"))
      (when (null? cells) (fail 'PARSE-GHERKIN-TABLE "a table row needs at least one cell"))
      (reverse cells))
    (define (read-table!)
      (define rows '())
      (define width #f)
      (let loop ()
        (when (and (< cursor (vector-length lines)) (string-prefix? (text) "|"))
          (define where (location))
          (define cells (table-row))
          (unless width (set! width (length cells)))
          (unless (= width (length cells))
            (fail 'PARSE-GHERKIN-TABLE "table rows must have the same width" where))
          (set! rows (cons (cons where cells) rows))
          (advance!)
          (loop)))
      (reverse rows))
    (let scan ()
      (when (< cursor (vector-length lines))
        (define line (text))
        (define where (location))
        (define heading (regexp-match #px"^(Feature|Background|Scenario Outline|Scenario|Example|Examples):[ \t]*(.*)$" line))
        (define action (regexp-match #px"^(Given|When|Then|And|But)[ \t]+(.+)$" line))
        (cond
          [(or (equal? line "") (string-prefix? line "#"))
           (when (and (string-prefix? line "# language:") (not (equal? line "# language: en")))
             (fail 'PARSE-GHERKIN-UNSUPPORTED "only English Gherkin is supported"))
           (advance!)]
          [(string-prefix? line "@")
           (unless (regexp-match? #px"^@[^ \t]+(?:[ \t]+@[^ \t]+)*$" line)
             (fail 'PARSE-GHERKIN-TAGS "invalid tags"))
           (set! pending-tags (append pending-tags (string-split line)))
           (advance!)]
          [heading
           (define keyword (cadr heading))
           (define name (caddr heading))
           (unless (or (member keyword '("Examples" "Background")) (not (equal? name "")))
             (fail 'PARSE-GHERKIN-HEADER "a section needs a name"))
           (cond
             [(equal? keyword "Feature")
              (when title (fail 'PARSE-GHERKIN-HEADER "one Feature is allowed per file"))
              (set! title name)
              (set! title-span where)
              (set! feature-tags pending-tags)
              (set! pending-tags '())
              (advance!)]
             [else
              (unless title (fail 'PARSE-GHERKIN-HEADER "Feature must come first"))
              (cond
                [(equal? keyword "Background")
                 (when (or background? (pair? cases) (pair? pending-tags))
                   (fail 'PARSE-GHERKIN-HEADER "Background must occur once before scenarios, without tags"))
                 (set! background? #t)
                 (set! mode 'background)
                 (set! current #f)
                 (set! previous-kind #f)
                 (advance!)]
                [(equal? keyword "Examples")
                 (unless (and current (draft-outline? current))
                   (fail 'PARSE-GHERKIN-EXAMPLES "Examples requires a Scenario Outline"))
                 (define example-tags pending-tags)
                 (set! pending-tags '())
                 (advance!)
                 (let skip ()
                   (when (and (< cursor (vector-length lines))
                              (or (equal? (text) "") (string-prefix? (text) "#")))
                     (advance!) (skip)))
                 (define rows (read-table!))
                 (unless (>= (length rows) 2)
                   (fail 'PARSE-GHERKIN-EXAMPLES "Examples needs a header and at least one row" where))
                 (define headers (cdar rows))
                 (unless (and (andmap (lambda (s) (not (equal? s ""))) headers)
                              (= (length headers) (length (remove-duplicates headers))))
                   (fail 'PARSE-GHERKIN-EXAMPLES "Examples headers must be nonempty and unique" where))
                 (set-draft-examples! current
                   (append (draft-examples current)
                           (for/list ([row (in-list (cdr rows))])
                             (example-row (car row) (map cons headers (cdr row)) example-tags))))
                 (set! mode 'examples)]
                [else
                 (set! current (draft name (equal? keyword "Scenario Outline") '() '() pending-tags where))
                 (set! cases (cons current cases))
                 (set! pending-tags '())
                 (set! mode 'scenario)
                 (set! previous-kind #f)
                 (advance!)])])]
          [action
           (unless (memq mode '(background scenario))
             (fail 'PARSE-GHERKIN-STEP "a step requires Background or Scenario"))
           (when (pair? pending-tags) (fail 'PARSE-GHERKIN-TAGS "tags must precede a section"))
           (define keyword (cadr action))
           (define kind
             (if (member keyword '("And" "But")) previous-kind (string->symbol keyword)))
           (unless kind (fail 'PARSE-GHERKIN-STEP "And or But needs a preceding step"))
           (set! previous-kind kind)
           (set-steps! (cons (step kind (caddr action) #f #f where) (active-steps)))
           (advance!)]
          [(string-prefix? line "\"\"\"")
           (define indent (- (string-length (raw)) (string-length (string-trim (raw) #:left? #t #:right? #f))))
           (unless (regexp-match? #px"^\"\"\"(?:[A-Za-z0-9_./+-]+)?$" line)
             (fail 'PARSE-GHERKIN-ARGUMENT "invalid Doc String delimiter"))
           (advance!)
           (define content '())
           (let read-doc ()
             (when (>= cursor (vector-length lines))
               (fail 'PARSE-GHERKIN-ARGUMENT "unterminated Doc String" where))
             (if (equal? (text) "\"\"\"")
                 (advance!)
                 (let* ([value (raw)]
                        [spaces (length (takef (string->list value) (lambda (ch) (memv ch '(#\space #\tab)))))])
                   (set! content (cons (substring value (min indent spaces)) content))
                   (advance!) (read-doc))))
           (attach! (string-join (reverse content) "\n") #f)]
          [(string-prefix? line "|")
           (attach! #f (map cdr (read-table!)))]
          [(or (regexp-match? #px"^(Rule:|Scenario Template:|Scenarios:|\\* |```)" line)
               (regexp-match? #px"^(Given|When|Then|And|But):" line))
           (fail 'PARSE-GHERKIN-UNSUPPORTED "unsupported or invalid Gherkin syntax")]
          [else
           (unless (and title (null? (active-steps)) (null? pending-tags) (not (eq? mode 'examples)))
             (fail 'PARSE-GHERKIN-STEP "unexpected text after steps"))
           (advance!)])
        (scan)))
    (unless title (fail 'PARSE-GHERKIN-HEADER "missing Feature" (location 0)))
    (when (pair? pending-tags) (fail 'PARSE-GHERKIN-TAGS "tags without a section" (location 0)))
    (when (null? cases) (fail 'PARSE-GHERKIN-EMPTY "Feature needs at least one scenario" title-span))
    (when (and background? (null? background))
      (fail 'PARSE-GHERKIN-EMPTY "Background needs steps" title-span))
    (define (substitute value bindings where)
      (regexp-replace* #px"<([^<>]+)>" value
        (lambda (whole name)
          (define entry (assoc name bindings))
          (unless entry (fail 'PARSE-GHERKIN-PARAMETER (format "no value for <~a>" name) where))
          (cdr entry))))
    (define expanded
      (append-map
       (lambda (item)
         (when (null? (draft-steps item))
           (fail 'PARSE-GHERKIN-EMPTY "Scenario needs steps" (draft-span item)))
         (when (and (draft-outline? item) (null? (draft-examples item)))
           (fail 'PARSE-GHERKIN-EXAMPLES "Scenario Outline needs Examples" (draft-span item)))
         (define all-steps (append (reverse background) (reverse (draft-steps item))))
         (define rows (if (draft-outline? item) (draft-examples item) (list #f)))
         (for/list ([row (in-list rows)])
           (define (replace value) (if row (substitute value (example-row-bindings row) (example-row-span row)) value))
           (scenario (replace (draft-name item))
             (for/list ([action (in-list all-steps)])
               (struct-copy step action
                 [text (replace (step-text action))]
                 [doc (and (step-doc action) (replace (step-doc action)))]
                 [table (and (step-table action) (map (lambda (cells) (map replace cells)) (step-table action)))]))
             (append feature-tags (draft-tags item) (if row (example-row-tags row) '()))
             (draft-span item) (and row (example-row-span row)))))
       (reverse cases)))
    (feature title expanded feature-tags title-span)))
