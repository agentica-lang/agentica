#lang racket

(require net/url "network.rkt" "http-wire.rkt" "builtin-types.rkt" "runtime-values.rkt" "diagnostic.rkt" "task.rkt")

(provide http-client? make-http-client close-http-client http-client-request
         default-client-options default-server-options validate-options)

(struct pool (count idle sockets changed) #:mutable)
(struct http-client (owner custodian options lock pools closed stopped) #:mutable)

(define (default-client-options)
  (record "HttpClientOptions" 30000 30000 4 67108864 ""))
(define (default-server-options)
  (record "HttpServerOptions" 30000 30000 128 67108864))

(define (validate-options options)
  (for ([(field value) (in-hash (instance-fields options))] #:unless (string=? field "ca_file"))
    (unless (exact-positive-integer? value) (error 'HTTP "option ~a must be positive" field)))
  (when (> (record-ref options "max_connections") 65536) (error 'HTTP "too many configured connections")))

(define (make-http-client options)
  (validate-options options)
  (define client (http-client (current-network-owner) (make-custodian) options
                              (make-semaphore 1) (make-hash) #f (make-semaphore 0)))
  (parameterize ([current-custodian (http-client-custodian client)])
    (thread
     (lambda ()
       (define idle-ms (record-ref options "idle_timeout_ms"))
       (let loop ()
         (sleep (/ idle-ms 1000))
         (call-with-semaphore (http-client-lock client)
           (lambda ()
             (for ([p (in-hash-values (http-client-pools client))])
               (expire-idle! p idle-ms))))
         (loop)))))
  client)

(define (expire-idle! p idle-ms)
  (define now (current-inexact-monotonic-milliseconds))
  (define-values (expired live)
    (partition (lambda (item) (or (net-socket-closed (car item))
                                  (>= (- now (cdr item)) idle-ms))) (pool-idle p)))
  (set-pool-idle! p live)
  (for ([item (in-list expired)])
    (network-close (car item))
    (hash-remove! (pool-sockets p) (car item))
    (set-pool-count! p (sub1 (pool-count p)))
    (semaphore-post (pool-changed p))))

(define (check-client client)
  (unless (eq? (http-client-owner client) (current-network-owner)) (error 'HTTP "client belongs to another execution"))
  (when (http-client-closed client) (error 'HTTP "client is closed")))

(define (close-http-client client)
  (check-owner (http-client-owner client))
  (call-with-semaphore (http-client-lock client)
    (lambda ()
      (unless (http-client-closed client)
        (set-http-client-closed! client #t)
        (semaphore-post (http-client-stopped client))
        (for ([p (in-hash-values (http-client-pools client))])
          (for ([socket (in-hash-keys (pool-sockets p))]) (network-close socket))
          (semaphore-post (pool-changed p))))))
  ((current-network-shutdown) (http-client-custodian client))
  (void))

(define (parse-destination text)
  (define parsed (string->url text))
  (define scheme (url-scheme parsed))
  (unless (and (member scheme '("http" "https")) (url-host parsed) (not (url-user parsed)) (not (url-fragment parsed)))
    (error 'HTTP "URL must be an absolute http or https URL without credentials or fragment"))
  (define host (url-host parsed))
  (define port (or (url-port parsed) (if (string=? scheme "https") 443 80)))
  (define target-url (struct-copy url parsed [scheme #f] [host #f] [port #f] [user #f]))
  (define target (url->string target-url))
  (values scheme host port (if (or (string=? target "") (string-prefix? target "?"))
                              (string-append "/" target) target)
          (string-append (if (string-contains? host ":") (string-append "[" host "]") host)
                         (if (url-port parsed) (format ":~a" port) ""))))

(define (acquire client key host port tls? timeout slot pending)
  (define p
    (call-with-semaphore (http-client-lock client)
      (lambda () (check-client client)
        (hash-ref! (http-client-pools client) key
                   (lambda () (pool 0 '() (make-hasheq) (make-semaphore 0)))))))
  (let loop ()
    (define choice
      (call-with-semaphore (http-client-lock client)
        (lambda ()
          (check-client client)
          (expire-idle! p (record-ref (http-client-options client) "idle_timeout_ms"))
          (cond
            [(pair? (pool-idle p))
             (define socket (caar (pool-idle p)))
             (set-pool-idle! p (cdr (pool-idle p)))
             (set-box! slot (cons p socket))
             socket]
            [(< (pool-count p) (record-ref (http-client-options client) "max_connections"))
             (set-pool-count! p (add1 (pool-count p)))
             (set-box! slot (cons p #f))
             'connect]
            [else #f]))))
    (cond
      [(not choice) (sync (pool-changed p) (semaphore-peek-evt (http-client-stopped client))) (loop)]
      [(eq? choice 'connect)
       (define connection-cust (make-custodian (http-client-custodian client)))
       (set-box! pending connection-cust)
       (define socket
         (parameterize ([current-custodian connection-cust])
           (network-connect host port timeout (and tls? (record-ref (http-client-options client) "ca_file")))))
       (call-with-semaphore (http-client-lock client)
         (lambda ()
           (when (http-client-closed client) (network-close socket) (error 'HTTP "client is closed"))
           (set-box! slot (cons p socket))
           (hash-set! (pool-sockets p) socket #t)
           (set-box! pending #f)))
       socket]
      [(sync/timeout 0 (net-socket-input choice))
       (return-slot client slot #f)
       (loop)]
      [else choice])))

(define (return-slot client slot reusable?)
  (call-with-semaphore (http-client-lock client)
    (lambda ()
      (define lease (unbox slot))
      (when lease
        (set-box! slot #f)
        (define p (car lease))
        (define socket (cdr lease))
        (cond
          [(and reusable? socket (not (http-client-closed client)) (not (net-socket-closed socket)))
           (set-pool-idle! p (cons (cons socket (current-inexact-monotonic-milliseconds)) (pool-idle p)))]
          [else
           (when socket (network-close socket) (hash-remove! (pool-sockets p) socket))
           (set-pool-count! p (sub1 (pool-count p)))])
        (semaphore-post (pool-changed p))))))

(define (http-client-request client method url headers data length producer arg invoke spawn)
  (check-client client)
  (define options (http-client-options client))
  (define timeout (record-ref options "timeout_ms"))
  (define limit (record-ref options "max_body_bytes"))
  (define slot (box #f))
  (define pending (box #f))
  (define body #f)
  (define cust (make-custodian (http-client-custodian client)))
  (define lock (make-semaphore 1))
  (define uploaded? #f)
  (define upload-task #f)
  (define consumed? #f)
  (define reusable? #t)
  (define failure #f)
  (define (release complete?)
    (when (and complete? uploaded? upload-task)
      (sync (task-done-evt upload-task)))
    (call-with-semaphore lock
      (lambda ()
        (unless complete? (set! reusable? #f))
        (set! consumed? #t)
        (when (or (not complete?) uploaded?) (return-slot client slot reusable?))))
    (unless complete? ((current-network-shutdown) cust)))
  (define (abort)
    (when (unbox pending)
      (custodian-shutdown-all (unbox pending))
      (set-box! pending #f))
    (return-slot client slot #f)
    (custodian-shutdown-all cust))
  (with-handlers ([exn:fail? (lambda (e) (abort) (raise e))])
    (network-timed timeout
      (lambda ()
        (define-values (scheme host port target authority) (parse-destination url))
        (define socket (acquire client (list scheme host port) host port (string=? scheme "https") timeout slot pending))
        (define writer (make-http-writer socket limit))
        (write-request-head writer method target authority headers length timeout)
        (set! reusable? (not (connection-close? headers)))
        (define (upload)
          (let/ec stop
           (with-handlers ([exn:fail? (lambda (e)
                                     (set-http-writer-active! writer #f)
                                     (set! failure e)
                                     (when body (set-http-body-failure! body e))
                                     (return-slot client slot #f)
                                     (void))])
            (cond
              [producer
               (define result (invoke producer (list arg writer)))
               (when (or (diagnostic? result) (exit-code? result)) (stop result))
               (when (result-error? result) (error 'HTTP "~a" (result-error-message result)))
               (when (or (not result) (not (result-ok? result)))
                 (error 'HTTP "upload producer did not return a successful Result"))]
              [else
               (for ([start (in-range 0 (bytes-length data) 65536)])
                 (writer-write writer (bytes->list (subbytes data start (min (bytes-length data) (+ start 65536)))) timeout))])
            (unless (http-writer-finished writer) (writer-finish writer '() timeout))
            (set-http-writer-active! writer #f)
            (call-with-semaphore lock
              (lambda () (set! uploaded? #t) (when consumed? (return-slot client slot reusable?))))
            (void))))
        (set! upload-task (spawn upload cust))
        (parameterize ([current-custodian (http-client-custodian client)])
          (thread (lambda ()
                    (sync (task-done-evt upload-task))
                    ((current-network-shutdown) cust))))
        (when failure (raise failure))
        (match-define (list status response-headers mode count) (read-response-head socket timeout))
        (when failure (raise failure))
        (when (or (string=? method "HEAD") (memv status '(204 304)))
          (set! mode 'length) (set! count 0))
        (when (or (connection-close? response-headers) (eq? mode 'eof)) (set! reusable? #f))
        (set! body (make-http-body socket mode count limit release))
        (when failure (set-http-body-failure! body failure))
        (record "Response" status response-headers body))
      #:abort abort)))
