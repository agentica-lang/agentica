def main() -> Void
  script = "printf '%s|' \"$@\"; echo; echo err-line >&2; cat; exit 7"
  p = Result.unwrap!(Process.spawn("sh", ["-c", script, "sh", "a b;$x", "--allow-run", "ñ"], 5000))
  puts(Result.unwrap!(Process.read_line(p, 5000)))
  IO.inspect(Process.send(p, "ñ\n", 5000))
  IO.inspect(Process.read_line(p, 5000))
  IO.inspect(Process.send_bytes(p, [0, 255, 10], 5000))
  IO.inspect(Process.read_bytes(p, 0, 5000))
  IO.inspect(Process.read_bytes(p, 3, 5000))
  IO.inspect(Process.send(p, "one\r\ntwo", 5000))
  IO.inspect(Process.read_line(p, 5000))
  IO.inspect(Process.close_stdin(p, 5000))
  IO.inspect(Process.close_stdin(p, 5000))
  IO.inspect(Process.send(p, "x", 5000))
  IO.inspect(Process.read_line(p, 5000))
  IO.inspect(Process.read_line(p, 5000))
  IO.inspect(Process.read_bytes(p, 3, 5000))
  IO.inspect(Process.wait(p, 5000))
  IO.inspect(Process.wait(p, 5000))
  IO.warn("after wait")
  Process.close(p)
  Process.close(p)
  IO.inspect(Process.wait(p, 5000))
  IO.inspect(Process.read_line(p, 5000))
  IO.inspect(Process.send(p, "x", 5000))
  IO.inspect(Process.close_stdin(p, 5000))
end
