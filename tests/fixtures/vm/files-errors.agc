def at(dir: String, name: String) -> String
  return Result.unwrap!(Path.join([dir, name]))
end

def main() -> Void
  dir: String = System.args()[0]
  nul = String.from_code(0)
  file = at(dir, "file.txt")
  File.write_text(file, "data", 60000)
  missing = at(dir, "missing")
  IO.inspect(File.read_text(missing, 60000))
  IO.inspect(File.read_text(dir, 60000))
  IO.inspect(File.read_text(at(file, "x"), 60000))
  IO.inspect(File.read_text(file + "/", 60000))
  IO.inspect(File.write_text(dir, "x", 60000))
  IO.inspect(File.write_text(at(missing, "x"), "x", 60000))
  IO.inspect(File.write_text(file + "/", "x", 60000))
  IO.inspect(File.append_text(at(dir, "new") + "/", "x", 60000))
  IO.inspect(File.write_text(at(file, "x"), "x", 60000))
  IO.inspect(File.stat(missing, 60000))
  IO.inspect(File.stat(at(file, "x"), 60000))
  IO.inspect(Dir.list(missing, 60000))
  IO.inspect(Dir.list(file, 60000))
  IO.inspect(Dir.mkdir(at(at(file, "sub"), "deeper"), 60000))
  IO.inspect(Dir.mkdir(at(dir, "x//file.txt//sub"), 60000))
  IO.inspect(Dir.mkdir(dir + "/file.txt//sub", 60000))
  IO.inspect(File.open(missing, "read", 60000))
  IO.inspect(File.open(dir, "read", 60000))
  IO.inspect(File.open(dir, "write", 60000))
  IO.inspect(File.open(at(missing, "x"), "append", 60000))
  IO.inspect(File.open(file, "readwrite", 60000))
  IO.inspect(File.open("", "bogus", 60000))
  for timeout in [0, -1]
    IO.inspect(File.read_text(file, timeout))
    IO.inspect(File.write_text(file, "x", timeout))
    IO.inspect(File.append_text("", "x", timeout))
    IO.inspect(File.stat(file, timeout))
    IO.inspect(Dir.list(dir, timeout))
    IO.inspect(Dir.mkdir("", timeout))
    IO.inspect(File.open(file, "bogus", timeout))
  end
  for path in ["", "a" + nul, nul]
    IO.inspect(File.read_text(path, 60000))
    IO.inspect(File.write_text(path, "x", 60000))
    IO.inspect(File.append_text(path, "x", 60000))
    IO.inspect(File.stat(path, 60000))
    IO.inspect(Dir.list(path, 60000))
    IO.inspect(Dir.mkdir(path, 60000))
    IO.inspect(File.open(path, "read", 60000))
    IO.inspect(File.open(path, "write", 60000))
  end
  h = Result.unwrap!(File.open(file, "read", 60000))
  IO.inspect(File.read_bytes(h, 0, 60000))
  IO.inspect(File.read_bytes(h, 1048577, 0))
  IO.inspect(File.read_bytes(h, 1, 0))
  IO.inspect(File.read_line(h, -5))
  IO.inspect(File.flush(h, 0))
  IO.inspect(File.close(h, 0))
  w = Result.unwrap!(File.open(at(dir, "w.txt"), "write", 60000))
  IO.inspect(File.write_bytes(w, [256], 0))
  IO.inspect(File.write_bytes(w, [-1], 60000))
  IO.inspect(File.write(w, "x", 0))
  IO.inspect(File.write_bytes(w, [1], -1))
  File.close(w, 60000)
  IO.inspect(File.close(w, 0))
end
