def main() -> Void
  listener = Result.unwrap!(TCP.listen("127.0.0.1", 0))
  port = TCP.local_port(listener)
  IO.inspect(TCP.accept(listener, 0))
  IO.inspect(TCP.accept(listener, 30))
  IO.inspect(TCP.connect("127.0.0.1", port, 0))
  IO.inspect(TCP.connect("127.0.0.1", 0, 1000))
  IO.inspect(TCP.connect("127.0.0.1", 65536, 1000))
  IO.inspect(TCP.connect("127.0.0.1#{String.from_code(0)}", port, 1000))
  IO.inspect(TCP.listen("127.0.0.1", -1))
  IO.inspect(TCP.listen("127.0.0.1", 65536))
  client = Result.unwrap!(TCP.connect("127.0.0.1", port, 5000))
  server = Result.unwrap!(TCP.accept(listener, 5000))
  IO.inspect(TCP.recv_bytes(client, 0, 1000))
  IO.inspect(TCP.recv_bytes(client, 1048577, 1000))
  IO.inspect(TCP.recv_bytes(client, 1, 0))
  IO.inspect(TCP.read_line(client, -1))
  IO.inspect(TCP.send(client, "x", 0))
  IO.inspect(TCP.send_bytes(client, (Bytes.from_list(List.repeat(0, 1048576)).unwrap! + "x".bytes), 1000))
  IO.inspect(TCP.read_line(server, 30))
  IO.inspect(TCP.read_line(server, 1000))
  IO.inspect(TCP.recv_bytes(server, 1, 1000))
  IO.inspect(TCP.send(server, "x", 1000))
  IO.inspect(TCP.read_line(client, 1000))
  IO.inspect(TCP.recv_bytes(client, 5, 1000))
  TCP.close(client)
  IO.inspect(TCP.send_bytes(client, "x".bytes, 1000))
  IO.inspect(TCP.read_line(client, 1000))
  TCP.close(server)
  TCP.close_listener(listener)
  IO.inspect(Result.ok?(TCP.connect("127.0.0.1", port, 1000)))
  IO.inspect(TCP.accept(listener, 1000))
  IO.inspect(TCP.accept(listener, 0))
  puts(TCP.local_port(listener) == port)
  TCP.close_listener(listener)
end
