def at(dir: String, name: String) -> String
  return Result.unwrap!(Path.join([dir, name]))
end

def main() -> Void
  dir: String = System.args()[0]
  path = at(dir, "lines.txt")
  out = Result.unwrap!(File.open(path, "write", 60000))
  IO.inspect(out)
  IO.inspect(File.write(out, "one\r\ntwo\n\nλ", 60000))
  IO.inspect(File.write_bytes(out, [10, 108, 97, 115, 116], 60000))
  IO.inspect(File.flush(out, 60000))
  IO.inspect(File.read_line(out, 60000))
  IO.inspect(File.read_bytes(out, 1, 60000))
  IO.inspect(File.close(out, 60000))
  IO.inspect(File.close(out, 60000))
  IO.inspect(File.write(out, "x", 60000))
  IO.inspect(File.flush(out, 60000))
  more = Result.unwrap!(File.open(path, "append", 60000))
  IO.inspect(File.write(more, "\r\n\r", 60000))
  IO.inspect(File.close(more, 60000))
  input = Result.unwrap!(File.open(path, "read", 60000))
  IO.inspect(File.write(input, "x", 60000))
  IO.inspect(File.flush(input, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_bytes(input, 2, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_bytes(input, 5, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.close(input, 60000))
  bad = at(dir, "bad.bin")
  raw = Result.unwrap!(File.open(bad, "write", 60000))
  File.write_bytes(raw, [97, 255, 10, 192, 128, 10, 226, 130, 172, 10, 0, 10], 60000)
  File.close(raw, 60000)
  input = Result.unwrap!(File.open(bad, "read", 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_line(input, 60000))
  IO.inspect(File.read_bytes(input, 1048576, 60000))
  IO.inspect(File.read_text(bad, 60000))
  left_open = Result.unwrap!(File.open(at(dir, "open.txt"), "write", 60000))
  IO.inspect(File.write(left_open, "kept", 60000))
end
