def main() -> Void
  j = Result.unwrap!(JSON.parse("{\"s\": \"text\", \"i\": 7, \"f\": 2.5, \"b\": true, \"l\": [1, \"x\"], \"n\": null, \"big\": 99999999999999999999, \"neg\": -1}"))
  puts(JSON.get(j, "s"))
  puts(JSON.get(j, "nope"))
  puts(JSON.get(j, "q\"uote\n"))
  puts(JSON.get(Result.unwrap!(JSON.get(j, "l")), "s"))
  l = Result.unwrap!(JSON.get(j, "l"))
  puts(JSON.at(l, 0))
  puts(JSON.at(l, 1).unwrap_or(j))
  puts(JSON.at(l, 2))
  puts(JSON.at(l, -1))
  puts(JSON.at(j, 0))
  puts(JSON.string(Result.unwrap!(JSON.get(j, "s"))))
  puts(JSON.string(Result.unwrap!(JSON.get(j, "i"))))
  puts(JSON.int(Result.unwrap!(JSON.get(j, "i"))))
  puts(JSON.int(Result.unwrap!(JSON.get(j, "f"))))
  puts(JSON.int(Result.unwrap!(JSON.get(j, "big"))))
  puts(JSON.float(Result.unwrap!(JSON.get(j, "i"))))
  puts(JSON.float(Result.unwrap!(JSON.get(j, "f"))))
  puts(JSON.float(Result.unwrap!(JSON.get(j, "big"))))
  puts(JSON.float(Result.unwrap!(JSON.get(j, "s"))))
  puts(JSON.bool(Result.unwrap!(JSON.get(j, "b"))))
  puts(JSON.bool(Result.unwrap!(JSON.get(j, "n"))))
  puts(JSON.list(l))
  puts(JSON.list(j))
  puts(JSON.null?(Result.unwrap!(JSON.get(j, "n"))))
  puts(j.get("neg").unwrap_or(j).int)
  puts(Result.unwrap!(JSON.get(j, "s")).string)
end
