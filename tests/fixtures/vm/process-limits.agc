def main() -> Void
  p = Result.unwrap!(Process.spawn("sh", ["-c", "printf '\\377\\nvalid\\r\\n'; cat"], Process.Options(timeout_ms: 5000)))
  IO.inspect(Process.read_line(p, 5000))
  IO.inspect(Process.read_line(p, 5000))
  IO.inspect(Process.read_bytes(p, -1, 1000))
  IO.inspect(Process.read_bytes(p, 1048577, 1000))
  IO.inspect(Process.send_bytes(p, (Bytes.from_list(List.repeat(97, 1048576)).unwrap! + "a".bytes), 1000))
  IO.inspect(Process.send(p, String.join(List.repeat("a", 1048576), "") + "a", 1000))
  IO.inspect(Process.read_line(p, 0))
  IO.inspect(Process.send(p, "x", -5))
  IO.inspect(Process.wait(p, 0))
  IO.inspect(Process.close_stdin(p, 0))
  IO.inspect(Process.spawn("sh", ["-c", "true"], Process.Options(timeout_ms: 0)))
  IO.inspect(Process.spawn("", [], Process.Options(timeout_ms: 1000)))
  IO.inspect(Process.spawn("sh", [String.from_code(0)], Process.Options(timeout_ms: 1000)))
  IO.inspect(Process.spawn("agentica-no-such-command-7h", [], Process.Options(timeout_ms: 1000)))
  IO.inspect(Process.spawn("./agentica-no-such-command-7h", [], Process.Options(timeout_ms: 1000)))
  Process.close(p)
  big = "head -c 1048576 /dev/zero | tr '\\0' c; echo; head -c 1048577 /dev/zero | tr '\\0' b; echo; echo tail"
  q = Result.unwrap!(Process.spawn("sh", ["-c", big], Process.Options(timeout_ms: 5000)))
  IO.inspect(String.length(Result.unwrap!(Process.read_line(q, 5000))))
  IO.inspect(Process.read_line(q, 5000))
  IO.inspect(Process.read_line(q, 5000))
  IO.inspect(Process.wait(q, 5000))
end
