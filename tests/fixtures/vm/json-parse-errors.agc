def show(text: String) -> Void
  case JSON.parse(text)
    ok(j) -> puts("ok #{j}")
    error(m) -> puts(m)
  end
end

def main() -> Void
  show("\"a" + String.from_code(1) + "\"")
  show("x \"" + String.from_code(31) + "\"")
  show("\"\\\"" + String.from_code(10) + "\"")
  show("")
  show(" \t\r\n ")
  show("[1,]")
  show("{\"a\" 1}")
  show("{1: 2}")
  show("tru")
  show("truex")
  show("nullnull")
  show("[01]")
  show("-")
  show("1.")
  show(".5")
  show("1e+")
  show("\"\\ud800\"")
  show("\"\\udc00\"")
  show("\"\\ud800\\u0041\"")
  show("\"\\x\"")
  show("\"unterminated")
  show(String.from_code(12) + "1")
  show(String.from_code(160) + "1")
  show(String.from_code(65279) + "1")
  show("[1] x")
  show("1 2")
  show("01")
  show("true-")
  show("\"a\"\"b\"")
  show("{} " + String.from_code(12))
  show("1e400")
  show("[-1e400]")
  show("{\"a\": [1e999]}")
  show("1e400 x")
  show("[1e400")
end
