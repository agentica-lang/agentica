def client(port: Int) -> String
  socket = Result.unwrap!(TCP.connect("127.0.0.1", port, 5000))
  Result.unwrap!(TCP.send(socket, "hello\r\n", 5000))
  Result.unwrap!(TCP.send_bytes(socket, Bytes.from_list([195]).unwrap!, 5000))
  Result.unwrap!(TCP.send_bytes(socket, Bytes.from_list([177, 240, 159, 152, 128, 10]).unwrap!, 5000))
  Result.unwrap!(TCP.send_bytes(socket, Bytes.from_list([98, 97, 100, 255, 10]).unwrap!, 5000))
  Result.unwrap!(TCP.send_bytes(socket, Bytes.from_list([1, 2, 3]).unwrap!, 5000))
  Result.unwrap!(TCP.send(socket, "last\r", 5000))
  reply = Result.unwrap!(TCP.read_line(socket, 5000))
  TCP.close(socket)
  TCP.close(socket)
  return reply
end

def main() -> Void
  listener = Result.unwrap!(TCP.listen("127.0.0.1", 0))
  port = TCP.local_port(listener)
  task = Task.spawn(&client, port)
  socket = Result.unwrap!(TCP.accept(listener, 5000))
  first = TCP.read_line(socket, 5000)
  second = TCP.read_line(socket, 5000)
  third = TCP.read_line(socket, 5000)
  Result.unwrap!(TCP.send(socket, "echo #{Result.unwrap!(first)} #{Result.unwrap!(second)}\n", 5000))
  reply = Task.await(task)
  head = TCP.recv_bytes(socket, 2, 5000)
  next = TCP.recv_bytes(socket, 1, 5000)
  last = TCP.read_line(socket, 5000)
  eof = TCP.recv_bytes(socket, 10, 5000)
  after = TCP.read_line(socket, 5000)
  TCP.close(socket)
  TCP.close_listener(listener)
  IO.inspect(listener)
  IO.inspect(socket)
  puts(port > 0)
  IO.inspect(first)
  IO.inspect(second)
  IO.inspect(third)
  puts(reply)
  IO.inspect(head)
  IO.inspect(next)
  IO.inspect(last)
  IO.inspect(eof)
  IO.inspect(after)
end
