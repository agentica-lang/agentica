def main() -> Void
  top = 9223372036854775807
  bottom = -top - 1
  puts(Int.bit_and(12, 10))
  puts(Int.bit_or(12, 10))
  puts(Int.bit_xor(12, 10))
  puts(Int.bit_and(-1, 255))
  puts(Int.bit_or(bottom, 1))
  puts(Int.bit_xor(top, -1))
  puts(Int.bit_not(0))
  puts(Int.bit_not(-1))
  puts(Int.bit_not(bottom))
  puts(Int.bit_not(top))
  puts(Int.bit_not(255))
  puts(1.shift_left(0))
  puts(1.shift_left(1))
  puts(1.shift_left(62))
  puts(1.shift_left(63))
  puts(1.shift_left(64))
  puts(1.shift_left(65))
  puts(1.shift_left(top))
  puts((-1).shift_left(1))
  puts((-1).shift_left(63))
  puts(4611686018427387904.shift_left(1))
  puts(top.shift_left(1))
  puts(bottom.shift_left(1))
  puts(3.shift_left(8))
  puts((-7).shift_right(1))
  puts(7.shift_right(1))
  puts((-1).shift_right(10))
  puts((-8).shift_right(3))
  puts((-9).shift_right(3))
  puts(bottom.shift_right(63))
  puts(bottom.shift_right(62))
  puts(top.shift_right(62))
  puts(top.shift_right(63))
  puts(top.shift_right(64))
  puts(bottom.shift_right(64))
  puts(bottom.shift_right(top))
  puts(5.shift_right(0))
  puts((-5).shift_right(0))
  puts((-1).shift_right_unsigned(60))
  puts((-1).shift_right_unsigned(0))
  puts((-1).shift_right_unsigned(1))
  puts(bottom.shift_right_unsigned(63))
  puts(bottom.shift_right_unsigned(64))
  puts(bottom.shift_right_unsigned(top))
  puts(top.shift_right_unsigned(62))
  puts(top.shift_right_unsigned(64))
  puts(256.shift_right_unsigned(4))
  masks = [0, 1, 8, 16, 32, 63, 64]
  for n in masks
    puts("mask #{n}: #{(-1).shift_right_unsigned(64 - n)}")
  end
  flags = 5
  puts(flags.bit_and(4) == 4)
  puts(flags.shift_right(1).bit_and(1) == 1)
  puts(flags.bit_or(2).bit_xor(1).bit_not)
end
