def show(text: String) -> Void
  case JSON.parse(text)
    ok(j) -> puts("#{text}: #{j} int=#{JSON.int(j)} float=#{JSON.float(j)}")
    error(m) -> puts("#{text}: #{m}")
  end
end

def main() -> Void
  show("9223372036854775807")
  show("9223372036854775808")
  show("-9223372036854775808")
  show("-9223372036854775809")
  show("18446744073709551616")
  show("[123456789012345678901234567890, -123456789012345678901234567890]")
  show("-0")
  show("-0.0")
  show("-0e5")
  show("0.0e-999")
  show("-1e-500")
  show("1e400")
  show("-1e400")
  show("2.4703282292062328e-324")
  show("9007199254740993")
  show("9007199254740993.0")
  show("1.00000000000000011102230246251565404236316680908203125")
  show("")
  show("")
  big = Result.unwrap!(JSON.parse("[-9223372036854775809, {\"n\": 9223372036854775808}]"))
  puts(JSON.encode(big))
  puts(JSON.encode(JSON.array([big, JSON.from(-0.0), JSON.from(9223372036854775807)])))
end
