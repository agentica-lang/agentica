def show(label: String, value: String) -> Void
  puts("#{label}: #{value.inspect}")
end

def main() -> Void
  text = "  Crème brûlée 😀 naïvé\t\n"
  puts(text.length)
  puts(String.length(""))
  show("trim", text.trim)
  vt = String.from_code(11)
  show("trim keeps", "#{vt} 　 x 　 #{vt}".trim)
  ff = String.from_code(12)
  show("trim all", " \t\n#{ff}\r".trim)
  show("trim inside", "#{ff} a \t b #{ff}".trim)
  show("upcase", text.upcase)
  show("downcase", "ÀÉÎ ΟΔΥΣΣΕΥΣ ΣΑ".downcase)
  show("special up", "straße ﬁ ŉ ǰ".upcase)
  show("special down", "İSTANBUL Σ ΑΣ. ÁΣ".downcase)
  puts("a,b,,c,".split(",").inspect)
  puts(",".split(",").inspect)
  puts("".split(",").inspect)
  puts("".split("").inspect)
  puts("é😀é".split("").inspect)
  puts("aaa".split("aa").inspect)
  puts("a😀b😀😀c".split("😀").inspect)
  puts("line one\nline two\n".split("\n").inspect)
  puts("no separator".split("--").inspect)
  show("join", String.join(["α", "", "😀", "z"], ", "))
  show("join one", ["only"].join("-"))
  empty: List[String] = []
  show("join none", empty.join("-"))
  show("join empty sep", ["a", "b", "c"].join(""))
  puts("héllo wörld".contains?("ö"))
  puts("héllo".contains?("hello"))
  puts("".contains?(""))
  puts("😀abc".starts_with?("😀"))
  puts("abc".starts_with?("abcd"))
  puts("abc😀".ends_with?("c😀"))
  puts("abc".ends_with?(""))
  show("replace", "a-b-c".replace("-", "→"))
  show("replace grow", "éé".replace("é", "eacute"))
  show("replace empty", "a😀".replace("", "|"))
  show("replace in empty", "".replace("", "|"))
  show("replace none", "abc".replace("x", "y"))
  show("replace overlap", "aaaa".replace("aa", "b"))
  show("slice", "Crème brûlée".slice(6, 6))
  show("slice end", "😀😀😀".slice(3, 0))
  show("slice all", String.slice("añb", 0, 3))
  puts("brûlée".index_of("lée").inspect)
  puts("😀a😀b".index_of("b").inspect)
  puts("abc".index_of("").inspect)
  puts("abc".index_of("é").inspect)
  puts("abc".index_of("\"q\"\n").inspect)
  show("at", "a😀é".at(1))
  show("at last", String.at("a😀é", 2))
  show("reverse", "añ😀é".reverse)
  show("reverse empty", "".reverse)
  puts("é".code)
  puts("😀".code)
  puts(String.code(String.from_code(0)))
  show("from_code", String.from_code(128512))
  show("from_code zero", String.from_code(0))
  show("from_code max", String.from_code(1114111))
  puts(String.from_bytes([240, 159, 152, 128, 33]).inspect)
  puts(String.from_bytes([]).inspect)
  puts(String.from_bytes([195]).inspect)
  puts(String.from_bytes([237, 160, 128]).inspect)
  puts(String.from_bytes([192, 128]).inspect)
  puts(String.from_bytes([195, 256]).inspect)
  puts(String.from_bytes([-1]).inspect)
  puts("42".to_int.inspect)
  puts("-0042".to_int.inspect)
  puts("+7".to_int.inspect)
  puts("9223372036854775807".to_int.inspect)
  puts("-9223372036854775808".to_int.inspect)
  puts("9223372036854775808".to_int.inspect)
  puts("12a".to_int.inspect)
  puts(" 12".to_int.inspect)
  puts("1.0".to_int.inspect)
  puts("١٢".to_int.inspect)
  puts("".to_int.inspect)
  puts("-5".to_int!)
  puts("3.25".to_float.inspect)
  puts("-0".to_float.inspect)
  puts("-0.0".to_float.inspect)
  puts("10".to_float.inspect)
  puts("0.1".to_float.inspect)
  puts("9007199254740993".to_float.inspect)
  puts("123456789012345678901234567890.123456789".to_float.inspect)
  puts("1e5".to_float.inspect)
  puts("inf".to_float.inspect)
  puts("1.".to_float.inspect)
  puts(".5".to_float.inspect)
  puts("0x10".to_float.inspect)
  puts("héllo".size)
  puts("12".to_i.inspect)
  puts("-3".to_i!)
  puts("2.5".to_f.inspect)
  puts("2.5".to_f!)
  puts(" é ".strip.inspect)
  puts("héllo".include?("él"))
  puts("héllo".start_with?("hé"))
  puts("héllo".end_with?("lo"))
  nines = "9999999999".replace("9", "9999999999")
  nines = nines.replace("9", "9999")
  puts(nines.length)
  puts("#{nines}.5".to_float.inspect)
  puts("0.#{"0000000000".replace("0", "00000000000000000000000000000000")}5".to_float.inspect)
  puts("0.#{"0000000000".replace("0", "000000000000000000000000000000000")}5".to_float.inspect)
  puts("-0.0".to_float.inspect)
  puts("5.".to_float.inspect)
  puts(".5".to_float.inspect)
  shy = String.from_code(173)
  zwj = String.from_code(8205)
  ypo = String.from_code(837)
  show("sigma shy", "Α#{shy}Σ#{shy}".downcase)
  show("sigma shy after", "ΑΣ#{shy}Β".downcase)
  show("sigma zwj", "Α#{zwj}Σ #{zwj}Σ".downcase)
  show("sigma ypo", "#{ypo}Σ 1#{ypo}Σ ΑΣ#{ypo}".downcase)
  show("ypo up", "ᾳ#{ypo}".upcase)
  puts("2.5".to_float!)
end
