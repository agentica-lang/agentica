def main() -> Void
  xs = [
    1,
    2,
    # before a closing bracket
  ]
  ys = [
    # inside an empty list
  ]
  m = {
    "a": 1, # after a map key
  }
  total = xs.map do |x| # after the block parameters
    x * 2
  end.size
  # between chain lines
  xs.each do
    # after do with no parameter
    puts(1)
  end
  puts(
    total, # after an argument
  )
  puts() # after an empty call
end
