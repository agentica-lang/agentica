def answer(f: Fn[Int]) -> Int = f.call()

def loop(f: Fn[Int]) -> Int = f.call()

def ready(f: Fn[Int, Bool]) -> Bool = f.call(1)

def each_pair(xs: List[Int], body: Fn[Int, Int, Void]) -> Void
  body.call(xs[0], xs[1])
end

def main() -> Void
  xs = [1, 2, 3]
  xs.each do |x| puts(x) end
  n = answer do 4 end
  m = answer { 5 }
  ys = xs.map { |x| x + 1 }
  zs = xs.map { |x|
    y = x * 2
    y + 1
  }

  k = loop() do 6 end
  xs |> each_pair() do |a, b| puts(a + b) end
  if ready() do |x| x > 0 end
    puts("if")
  elsif xs.any? do |x| x > 0 end
    puts("elsif")
  end
  return if ready() do |x| x > 5 end
  j = Box.answer do 7 end
  puts(n + m + k + j + ys.size + zs.size)
end
