def answer(f: Fn[Int]) -> Int = f.call()

def loop(f: Fn[Int]) -> Int = f.call()

def ready(f: Fn[Int, Bool]) -> Bool = f.call(1)

def same(b: Bool) -> Bool = b

def each_pair(xs: List[Int], body: Fn[Int, Int, Void]) -> Void
  body.call(xs[0], xs[1])
end

def main() -> Void
  xs = [1, 2, 3]
  xs.each() do |x| puts(x) end
  n = answer() do 4 end
  m = answer { 5 }
  ys = xs.map {   |x|   x + 1 }
  zs = xs.map { |x|
    y = x * 2
    y + 1
  }
  k = loop() do 6 end
  xs |> each_pair() do |a, b| puts(a + b) end
  if ready() do |x| x > 0 end
    puts("if")
  elsif xs.any?() do |x| x > 0 end
    puts("elsif")
  end
  return if ready() do |x| x > 5 end
  j = Box.answer() do 7 end
  puts(n + m + k + j + ys.size + zs.size)
end

def heads(xs: List[Int], z: Int) -> Int
  if (xs.any? { |x| x > 0 })
    puts("braces")
  elsif (xs.all? { |x| x > z })
    puts("elsif")
  end
  if (ready do |x| x > 0 end)
    puts("bare")
  end
  if (ready() do |x| x > 1 end) and (xs.none? { |x| x > 9 })
    puts("both")
  end
  while (xs.any? do |x| x > 5 end) do
    puts("while")
  end
  while (xs.any? { |x| x > 5 })
    puts("while")
  end
  for y in (xs.map { |x| x + 1 })
    puts(y)
  end
  for y in (xs.map do |x| x end) do
    puts(y)
  end
  case (xs.map { |x| x }) do
    _ -> puts("case")
  end
  for x in xs
    next if (xs.any? { |y| y > z })
  end
  0
end

def inside(xs: List[Int], z: Int) -> Int
  if xs.include?(answer { 5 })
    puts("argument")
  end
  if xs.any?() do |x| answer { x } > 0 end
    puts("body")
  end
  return 1 if [answer { 5 }].size > z
  if ("#{xs.any? { |x| x > 0 }}" == "true")
    puts("interpolation")
  end
  if ({1: xs.any? { |x| x > 0 }}.size > 0)
    puts("map")
  end
  while ("#{xs.any? do |x| x > 5 end}" == "true")
    puts("while")
  end
  case z
    0 if (ready do |v| v > 0 end) -> puts(6)
    1 if (xs.any? { |v| v > 0 }) -> puts(7)
    2 if xs.empty? |> same() -> puts(8)
    3 if (ready do |v| v > 0 end) |> same() -> puts(10)
    4 if (xs.any? { |v| v > 0 }) |> same() |> same() -> puts(11)
    5 if (xs.size > 0) |> same() -> puts(12)
    6 if ((ready do |v| v > 0 end)) -> puts(13)
    _ -> puts(9)
  end
  0
end
