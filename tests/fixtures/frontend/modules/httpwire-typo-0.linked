        value: try-expr #175 14073:224:3-14097:224:27
          operand: call #174 14077:224:7-14097:224:27 name="@2::check_proxy" piped=false
            arg: name-ref #173 14089:224:19-14096:224:26 name="options"
      body: binding #181 14100:225:3-14155:226:1 name="jobs"
        type: type-ref #178 14106:225:9-14127:225:30 name="Channel"
          arg: type-ref #177 14114:225:17-14126:225:29 name="HttpWire.Job"
