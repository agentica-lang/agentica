    declaration: struct-decl #40 2142:46:1-3017:63:1 name="@2::Connection" doc="An HTTP/1.1 connection that the program drives itself, as `Net::HTTP.start` gives: one request at a time, and the\nbody read piece by piece. Open it with `start`, send with `send_request`, read with `read_body` and end it with\n`finish`. The fields are the connection's own: do not read them. It belongs to the task that opened it, as a socket\ndoes, and one call at a time uses it."
      field: field-decl #25 2205:48:3-2224:49:1 name="socket" doc="The socket, a plain one or a TLS one."
        type: type-ref #24 2213:48:11-2223:48:21 name="TCP.Socket"
      field: field-decl #27 2303:50:3-2318:51:1 name="scheme" doc="`http` or `https`, the host and the port, which the request head names."
        type: type-ref #26 2311:50:11-2317:50:17 name="String"
      field: field-decl #29 2320:51:3-2333:52:1 name="host"
        type: type-ref #28 2326:51:9-2332:51:15 name="String"
