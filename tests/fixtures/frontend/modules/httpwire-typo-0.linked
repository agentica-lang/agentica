          arg: const-ref #179 14142:225:45-14153:225:56 name="@2::CLIENT_JOBS"
      body: return-stmt #192 14157:226:3-14232:226:78 implicit
        value: call #191 14157:226:3-14232:226:78 name="ok" piped=false
          arg: call #190 14160:226:6-14231:226:77 name="HttpWire.service" piped=false
            arg: name-ref #182 14177:226:23-14181:226:27 name="jobs"
            arg: name-ref #183 14183:226:29-14190:226:36 name="options"
