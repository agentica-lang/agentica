          arg: type-ref #48 3825:74:17-3840:74:32 name="HttpWire.Header"
    declaration: struct-decl #64 4733:85:1-4848:91:1 name="@2::Stream" doc="A response whose body arrives on a channel, from `open`: the `status` and `headers` of the head, the `body` channel\nand the `done` task that feeds it. The task reads the connection and sends each piece (up to 64 KiB, never empty),\nand it closes the channel on every path, so the reader runs the usual receive loop until the closed error and then\nawaits `done`: `ok` means the body ended cleanly, an `error` says why it did not (a cut body, a timeout, a bad\nchunk). To stop early the reader closes the channel: the task's next `send` fails, it closes the connection and\n`done` is an `error`. That works only while data flows: on a quiet stream the task waits in its read until\n`read_timeout_ms` (for ever when it is 0), so the prompt stop is `Task.cancel(stream.done)`, which closes the\nconnection at once. The connection belongs to the task and is never reused."
      field: field-decl #53 4749:86:3-4761:87:1 name="status"
        type: type-ref #52 4757:86:11-4760:86:14 name="Int"
      field: field-decl #56 4763:87:3-4794:88:1 name="headers"
        type: type-ref #55 4772:87:12-4793:87:33 name="List"
          arg: type-ref #54 4777:87:17-4792:87:32 name="HttpWire.Header"
      field: field-decl #59 4796:88:3-4817:89:1 name="body"
        type: type-ref #58 4802:88:9-4816:88:23 name="Channel"
          arg: type-ref #57 4810:88:17-4815:88:22 name="Bytes"
      field: field-decl #63 4819:89:3-4844:90:1 name="done"
        type: type-ref #62 4825:89:9-4843:89:27 name="Task"
          arg: type-ref #61 4830:89:14-4842:89:26 name="Result"
            arg: type-ref #60 4837:89:21-4841:89:25 name="Void"
    declaration: struct-decl #77 5296:96:1-6321:111:1 name="@2::StreamResponse" doc="A response whose body is sent as it is produced: the `status` and `headers` of the head, and a `body` channel of\npieces. The handler returns it at once and a task it spawned sends the pieces and closes the channel at the end. The\nserver sends each piece as soon as it arrives and ends the body when the channel closes. When the client leaves, the\nserver closes the channel, so the producer's next `send` returns an error and it stops."
      field: field-decl #66 5413:98:3-5425:99:1 name="status" doc="The status, 200 to 599, and not 204 or 304 unless the body is already closed and empty."
        type: type-ref #65 5421:98:11-5424:98:14 name="Int"
      field: field-decl #69 5546:100:3-5577:101:1 name="headers" doc="The response headers. The server adds `Transfer-Encoding: chunked` or `Content-Length`: the handler sets neither."
        type: type-ref #68 5555:100:12-5576:100:33 name="List"
          arg: type-ref #67 5560:100:17-5575:100:32 name="HttpWire.Header"
      field: field-decl #72 5661:102:3-5682:103:1 name="body" doc="The pieces of the body, as `Bytes` of any content (an empty one is skipped)."
        type: type-ref #71 5667:102:9-5681:102:23 name="Channel"
          arg: type-ref #70 5675:102:17-5680:102:22 name="Bytes"
      field: field-decl #76 6288:109:3-6317:110:1 name="length" doc="The size of the whole body in bytes, when the handler knows it (a file). The head then says `Content-Length` and\nthe pieces go out as they are, with no chunk framing, so a client can show progress and a range answer can\nstream. The producer must send exactly that many bytes and then close the channel: a body that ends short, or\na piece that would pass the length, cuts the connection (the client sees an incomplete body), and a body that is\nclosed when the handler returns and has another size is a 500. Not for a 204 or a 304. `none` is the default: the\nbody is chunked."
        type: type-ref #74 6296:109:11-6309:109:24 name="Optional"
          arg: type-ref #73 6305:109:20-6308:109:23 name="Int"
        default: call #75 6312:109:27-6316:109:31 name="none" piped=false
    declaration: type-alias-decl #82 6496:114:1-6559:115:1 name="@2::Handler" doc="A route that takes the request whole: the request in, the whole response out. `app` makes an `App` from it. A\nmiddleware is a function from a `Handler` to a `Handler`."
      target: type-ref #81 6511:114:16-6558:114:63 name="Fn"
        arg: type-ref #78 6514:114:19-6530:114:35 name="HttpWire.Request"
        arg: type-ref #80 6532:114:37-6557:114:62 name="Result"
          arg: type-ref #79 6539:114:44-6556:114:61 name="HttpWire.Response"
    declaration: struct-decl #91 7141:121:1-7216:125:1 name="@2::RequestBody" doc="The body of a request as it arrives, on a channel, for an `App`: the `pieces` channel (`Bytes` of any content, up\nto 64 KiB each, never empty, a chunked body already decoded) and the `done` task that feeds it. The task closes the\nchannel on every path, so the app runs the usual receive loop until the closed error and then awaits `done`: `ok`\nmeans the body arrived whole, an `error` says why it did not (the client left, a bad chunk, a timeout, a body over\n`max_body_bytes`). An app that answers before the whole body arrived ends the connection after its answer."
      field: field-decl #86 7162:122:3-7185:123:1 name="pieces"
        type: type-ref #85 7170:122:11-7184:122:25 name="Channel"
          arg: type-ref #84 7178:122:19-7183:122:24 name="Bytes"
      field: field-decl #90 7187:123:3-7212:124:1 name="done"
        type: type-ref #89 7193:123:9-7211:123:27 name="Task"
          arg: type-ref #88 7198:123:14-7210:123:26 name="Result"
            arg: type-ref #87 7205:123:21-7209:123:25 name="Void"
    declaration: enum-decl #105 8015:133:1-8130:141:1 name="@2::Message" type-parameters=[] doc="A message of a WebSocket, in either direction. `Text` and `Binary` are whole messages: the server joins the\nfragments of a message it receives, and a text message is checked as UTF-8. `Ping` and `Pong` carry at most 125\nbytes. The server answers every ping it receives with a pong, and does not hand it to the handler. `Close` is the\nend: the code (1000 to 1003 and 1007 to 1014 are the registered codes, 3000 to 4999 are for programs) and a reason\nof at most 123 bytes. It is always the last message the handler receives, and when the connection ended with no\nclose frame (the peer left, a timeout) its code is 1006. `Prepared` is a text or binary message already framed by\n`prepare`, so a broadcast does not frame its message for every socket; the server never receives one."
      variant: enum-variant #93 8030:134:3-8043:135:1 name="Text"
        payload: type-ref #92 8035:134:8-8041:134:14 name="String"
      variant: enum-variant #95 8045:135:3-8059:136:1 name="Binary"
        payload: type-ref #94 8052:135:10-8057:135:15 name="Bytes"
      variant: enum-variant #97 8061:136:3-8073:137:1 name="Ping"
        payload: type-ref #96 8066:136:8-8071:136:13 name="Bytes"
      variant: enum-variant #99 8075:137:3-8087:138:1 name="Pong"
        payload: type-ref #98 8080:137:8-8085:137:13 name="Bytes"
      variant: enum-variant #102 8089:138:3-8108:139:1 name="Close"
        payload: type-ref #100 8095:138:9-8098:138:12 name="Int"
        payload: type-ref #101 8100:138:14-8106:138:20 name="String"
      variant: enum-variant #104 8110:139:3-8126:140:1 name="Prepared"
        payload: type-ref #103 8119:139:12-8124:139:17 name="Bytes"
    declaration: struct-decl #114 8822:148:1-8920:153:1 name="@2::WebSocket" doc="An upgraded connection, for the session function of `accept_websocket`: messages from the peer arrive on `incoming`\nand the messages to send go on `outgoing`. `protocol` is the subprotocol that was agreed, or \"\". Both channels hold\n8 messages, so a handler that does not read makes the server stop reading the socket, and a handler that sends\nfaster than the peer reads waits. A session must keep taking messages from `incoming` (or end): while it does not,\nthe server does not read the socket, so the pings and the close of the peer go unanswered. `incoming` closes after\nthe `Close` message, and `outgoing` closes when the connection is over, so a send then is an error."
      field: field-decl #108 8841:149:3-8868:150:1 name="incoming"
        type: type-ref #107 8851:149:13-8867:149:29 name="Channel"
          arg: type-ref #106 8859:149:21-8866:149:28 name="@2::Message"
      field: field-decl #111 8870:150:3-8897:151:1 name="outgoing"
        type: type-ref #110 8880:150:13-8896:150:29 name="Channel"
          arg: type-ref #109 8888:150:21-8895:150:28 name="@2::Message"
      field: field-decl #113 8899:151:3-8916:152:1 name="protocol"
        type: type-ref #112 8909:151:13-8915:151:19 name="String"
    declaration: type-alias-decl #119 9196:157:1-9248:158:1 name="@2::WebSocketSession" doc="The function that runs a WebSocket after its handshake: it gets the `WebSocket` and returns when it is done. When it\nreturns, the server sends a close frame (code 1000, or 1011 for an `error`) if the session did not, waits for the\npeer's, and closes the connection."
      target: type-ref #118 9220:157:25-9247:157:52 name="Fn"
        arg: type-ref #115 9223:157:28-9232:157:37 name="@2::WebSocket"
        arg: type-ref #117 9234:157:39-9246:157:51 name="Result"
          arg: type-ref #116 9241:157:46-9245:157:50 name="Void"
    declaration: struct-decl #140 10171:167:1-10352:175:1 name="@2::WebSocketOptions" doc="The limits of a WebSocket. `max_message_bytes` is the largest message, joined from its fragments (1 to 256 MiB): a\nlarger one closes the connection with code 1009. `idle_ms` is the longest the server waits for the peer to send\nanything, 0 for no limit but a year (a read that times out closes the socket); a timeout drops the connection, and\nthe handler receives `Close` with code 1006. `ping_ms` makes the server send a ping after that many milliseconds\nwithout anything to write, 0 for none: with a `ping_ms` below `idle_ms` the pongs keep a live peer from being\ndropped. `close_ms` is how long the server waits for the peer's answer to its close frame. `protocols` are the\nsubprotocols the server speaks, in order of preference. `outgoing_queue` is how many messages `outgoing` holds (1 to\n1048576) before a send waits: the writer takes everything queued at that moment and writes it in one go."
      field: field-decl #123 10197:168:3-10230:169:1 name="max_message_bytes"
        type: type-ref #121 10216:168:22-10219:168:25 name="Int"
        default: literal #122 10222:168:28-10229:168:35 value=int:1048576
      field: field-decl #126 10232:169:3-10249:170:1 name="idle_ms"
        type: type-ref #124 10241:169:12-10244:169:15 name="Int"
        default: literal #125 10247:169:18-10248:169:19 value=int:0
      field: field-decl #129 10251:170:3-10268:171:1 name="ping_ms"
        type: type-ref #127 10260:170:12-10263:170:15 name="Int"
        default: literal #128 10266:170:18-10267:170:19 value=int:0
      field: field-decl #132 10270:171:3-10291:172:1 name="close_ms"
        type: type-ref #130 10280:171:13-10283:171:16 name="Int"
        default: literal #131 10286:171:19-10290:171:23 value=int:5000
      field: field-decl #136 10293:172:3-10322:173:1 name="protocols"
        type: type-ref #134 10304:172:14-10316:172:26 name="List"
          arg: type-ref #133 10309:172:19-10315:172:25 name="String"
        default: list-lit #135 10319:172:29-10321:172:31
      field: field-decl #139 10324:173:3-10348:174:1 name="outgoing_queue"
        type: type-ref #137 10340:173:19-10343:173:22 name="Int"
        default: literal #138 10346:173:25-10347:173:26 value=int:8
    declaration: enum-decl #148 10580:178:1-10685:182:1 name="@2::Upgrade" type-parameters=[] doc="What `accept_websocket` decides for a request, for an `Answer.Upgrade`: `Reply` answers it as a whole response (and\nthe connection serves the next request), `Accept` upgrades it. Make an `Accept` with `accept_websocket`."
