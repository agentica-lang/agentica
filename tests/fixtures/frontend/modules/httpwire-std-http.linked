          arg: const-ref #179 14142:225:45-14153:225:56 name="@2::CLIENT_JOBS"
      body: return-stmt #191 14157:226:3-14225:226:71 implicit
        value: call #190 14157:226:3-14225:226:71 name="ok" piped=false
          arg: call #189 14160:226:6-14224:226:70 name="HttpWire.service" piped=false
            arg: name-ref #182 14177:226:23-14181:226:27 name="jobs"
