        type: type-ref #664 29002:487:11-29005:487:14 name="Int"
        default: unary #666 29008:487:17-29010:487:19 op=minus op-span=29008:487:17-29009:487:18
          operand: literal #665 29009:487:18-29010:487:19 value=int:1
      param: param #671 29014:488:3-29049:488:38 name="headers"
