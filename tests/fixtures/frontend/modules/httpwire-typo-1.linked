          arg: const-ref #173 13526:219:45-13537:219:56 name="@2::CLIENT_JOBS"
      body: return-stmt #185 13541:220:3-13609:220:71 implicit
        value: call #184 13541:220:3-13609:220:71 name="ok" piped=false
          arg: call #183 13544:220:6-13608:220:70 name="HttpWire.service" piped=false
            arg: name-ref #176 13561:220:23-13565:220:27 name="jobs"
            arg: name-ref #177 13567:220:29-13574:220:36 name="options"
            arg: block-lit #182 13576:220:38-13608:220:70
              param: block-param #178 13580:220:42-13583:220:45 name="own"
              body: expr-stmt #181 13585:220:47-13604:220:66
