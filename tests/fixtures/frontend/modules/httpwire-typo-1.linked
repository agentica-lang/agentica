          arg: type-ref #49 3854:75:17-3869:75:32 name="HttpWire.Header"
    declaration: struct-decl #65 4762:86:1-4877:92:1 name="@2::Stream" doc="A response whose body arrives on a channel, from `open`: the `status` and `headers` of the head, the `body` channel\nand the `done` task that feeds it. The task reads the connection and sends each piece (up to 64 KiB, never empty),\nand it closes the channel on every path, so the reader runs the usual receive loop until the closed error and then\nawaits `done`: `ok` means the body ended cleanly, an `error` says why it did not (a cut body, a timeout, a bad\nchunk). To stop early the reader closes the channel: the task's next `send` fails, it closes the connection and\n`done` is an `error`. That works only while data flows: on a quiet stream the task waits in its read until\n`read_timeout_ms` (for ever when it is 0), so the prompt stop is `Task.cancel(stream.done)`, which closes the\nconnection at once. The connection belongs to the task and is never reused."
      field: field-decl #54 4778:87:3-4790:88:1 name="status"
        type: type-ref #53 4786:87:11-4789:87:14 name="Int"
      field: field-decl #57 4792:88:3-4823:89:1 name="headers"
        type: type-ref #56 4801:88:12-4822:88:33 name="List"
          arg: type-ref #55 4806:88:17-4821:88:32 name="HttpWire.Header"
      field: field-decl #60 4825:89:3-4846:90:1 name="body"
        type: type-ref #59 4831:89:9-4845:89:23 name="Channel"
          arg: type-ref #58 4839:89:17-4844:89:22 name="Bytes"
      field: field-decl #64 4848:90:3-4873:91:1 name="done"
        type: type-ref #63 4854:90:9-4872:90:27 name="Task"
          arg: type-ref #62 4859:90:14-4871:90:26 name="Result"
            arg: type-ref #61 4866:90:21-4870:90:25 name="Void"
    declaration: struct-decl #78 5325:97:1-6350:112:1 name="@2::StreamResponse" doc="A response whose body is sent as it is produced: the `status` and `headers` of the head, and a `body` channel of\npieces. The handler returns it at once and a task it spawned sends the pieces and closes the channel at the end. The\nserver sends each piece as soon as it arrives and ends the body when the channel closes. When the client leaves, the\nserver closes the channel, so the producer's next `send` returns an error and it stops."
      field: field-decl #67 5442:99:3-5454:100:1 name="status" doc="The status, 200 to 599, and not 204 or 304 unless the body is already closed and empty."
        type: type-ref #66 5450:99:11-5453:99:14 name="Int"
      field: field-decl #70 5575:101:3-5606:102:1 name="headers" doc="The response headers. The server adds `Transfer-Encoding: chunked` or `Content-Length`: the handler sets neither."
        type: type-ref #69 5584:101:12-5605:101:33 name="List"
          arg: type-ref #68 5589:101:17-5604:101:32 name="HttpWire.Header"
      field: field-decl #73 5690:103:3-5711:104:1 name="body" doc="The pieces of the body, as `Bytes` of any content (an empty one is skipped)."
        type: type-ref #72 5696:103:9-5710:103:23 name="Channel"
          arg: type-ref #71 5704:103:17-5709:103:22 name="Bytes"
      field: field-decl #77 6317:110:3-6346:111:1 name="length" doc="The size of the whole body in bytes, when the handler knows it (a file). The head then says `Content-Length` and\nthe pieces go out as they are, with no chunk framing, so a client can show progress and a range answer can\nstream. The producer must send exactly that many bytes and then close the channel: a body that ends short, or\na piece that would pass the length, cuts the connection (the client sees an incomplete body), and a body that is\nclosed when the handler returns and has another size is a 500. Not for a 204 or a 304. `none` is the default: the\nbody is chunked."
        type: type-ref #75 6325:110:11-6338:110:24 name="Optional"
          arg: type-ref #74 6334:110:20-6337:110:23 name="Int"
        default: call #76 6341:110:27-6345:110:31 name="none" piped=false
    declaration: type-alias-decl #83 6525:115:1-6588:116:1 name="@2::Handler" doc="A route that takes the request whole: the request in, the whole response out. `app` makes an `App` from it. A\nmiddleware is a function from a `Handler` to a `Handler`."
      target: type-ref #82 6540:115:16-6587:115:63 name="Fn"
        arg: type-ref #79 6543:115:19-6559:115:35 name="HttpWire.Request"
        arg: type-ref #81 6561:115:37-6586:115:62 name="Result"
          arg: type-ref #80 6568:115:44-6585:115:61 name="HttpWire.Response"
    declaration: struct-decl #92 7170:122:1-7245:126:1 name="@2::RequestBody" doc="The body of a request as it arrives, on a channel, for an `App`: the `pieces` channel (`Bytes` of any content, up\nto 64 KiB each, never empty, a chunked body already decoded) and the `done` task that feeds it. The task closes the\nchannel on every path, so the app runs the usual receive loop until the closed error and then awaits `done`: `ok`\nmeans the body arrived whole, an `error` says why it did not (the client left, a bad chunk, a timeout, a body over\n`max_body_bytes`). An app that answers before the whole body arrived ends the connection after its answer."
      field: field-decl #87 7191:123:3-7214:124:1 name="pieces"
        type: type-ref #86 7199:123:11-7213:123:25 name="Channel"
          arg: type-ref #85 7207:123:19-7212:123:24 name="Bytes"
      field: field-decl #91 7216:124:3-7241:125:1 name="done"
        type: type-ref #90 7222:124:9-7240:124:27 name="Task"
          arg: type-ref #89 7227:124:14-7239:124:26 name="Result"
            arg: type-ref #88 7234:124:21-7238:124:25 name="Void"
    declaration: enum-decl #106 8044:134:1-8159:142:1 name="@2::Message" type-parameters=[] doc="A message of a WebSocket, in either direction. `Text` and `Binary` are whole messages: the server joins the\nfragments of a message it receives, and a text message is checked as UTF-8. `Ping` and `Pong` carry at most 125\nbytes. The server answers every ping it receives with a pong, and does not hand it to the handler. `Close` is the\nend: the code (1000 to 1003 and 1007 to 1014 are the registered codes, 3000 to 4999 are for programs) and a reason\nof at most 123 bytes. It is always the last message the handler receives, and when the connection ended with no\nclose frame (the peer left, a timeout) its code is 1006. `Prepared` is a text or binary message already framed by\n`prepare`, so a broadcast does not frame its message for every socket; the server never receives one."
      variant: enum-variant #94 8059:135:3-8072:136:1 name="Text"
        payload: type-ref #93 8064:135:8-8070:135:14 name="String"
      variant: enum-variant #96 8074:136:3-8088:137:1 name="Binary"
        payload: type-ref #95 8081:136:10-8086:136:15 name="Bytes"
      variant: enum-variant #98 8090:137:3-8102:138:1 name="Ping"
        payload: type-ref #97 8095:137:8-8100:137:13 name="Bytes"
      variant: enum-variant #100 8104:138:3-8116:139:1 name="Pong"
        payload: type-ref #99 8109:138:8-8114:138:13 name="Bytes"
      variant: enum-variant #103 8118:139:3-8137:140:1 name="Close"
        payload: type-ref #101 8124:139:9-8127:139:12 name="Int"
        payload: type-ref #102 8129:139:14-8135:139:20 name="String"
      variant: enum-variant #105 8139:140:3-8155:141:1 name="Prepared"
        payload: type-ref #104 8148:140:12-8153:140:17 name="Bytes"
    declaration: struct-decl #115 8851:149:1-8949:154:1 name="@2::WebSocket" doc="An upgraded connection, for the session function of `accept_websocket`: messages from the peer arrive on `incoming`\nand the messages to send go on `outgoing`. `protocol` is the subprotocol that was agreed, or \"\". Both channels hold\n8 messages, so a handler that does not read makes the server stop reading the socket, and a handler that sends\nfaster than the peer reads waits. A session must keep taking messages from `incoming` (or end): while it does not,\nthe server does not read the socket, so the pings and the close of the peer go unanswered. `incoming` closes after\nthe `Close` message, and `outgoing` closes when the connection is over, so a send then is an error."
      field: field-decl #109 8870:150:3-8897:151:1 name="incoming"
        type: type-ref #108 8880:150:13-8896:150:29 name="Channel"
          arg: type-ref #107 8888:150:21-8895:150:28 name="@2::Message"
      field: field-decl #112 8899:151:3-8926:152:1 name="outgoing"
        type: type-ref #111 8909:151:13-8925:151:29 name="Channel"
          arg: type-ref #110 8917:151:21-8924:151:28 name="@2::Message"
      field: field-decl #114 8928:152:3-8945:153:1 name="protocol"
        type: type-ref #113 8938:152:13-8944:152:19 name="String"
    declaration: type-alias-decl #120 9225:158:1-9277:159:1 name="@2::WebSocketSession" doc="The function that runs a WebSocket after its handshake: it gets the `WebSocket` and returns when it is done. When it\nreturns, the server sends a close frame (code 1000, or 1011 for an `error`) if the session did not, waits for the\npeer's, and closes the connection."
      target: type-ref #119 9249:158:25-9276:158:52 name="Fn"
        arg: type-ref #116 9252:158:28-9261:158:37 name="@2::WebSocket"
        arg: type-ref #118 9263:158:39-9275:158:51 name="Result"
          arg: type-ref #117 9270:158:46-9274:158:50 name="Void"
    declaration: struct-decl #141 10200:168:1-10381:176:1 name="@2::WebSocketOptions" doc="The limits of a WebSocket. `max_message_bytes` is the largest message, joined from its fragments (1 to 256 MiB): a\nlarger one closes the connection with code 1009. `idle_ms` is the longest the server waits for the peer to send\nanything, 0 for no limit but a year (a read that times out closes the socket); a timeout drops the connection, and\nthe handler receives `Close` with code 1006. `ping_ms` makes the server send a ping after that many milliseconds\nwithout anything to write, 0 for none: with a `ping_ms` below `idle_ms` the pongs keep a live peer from being\ndropped. `close_ms` is how long the server waits for the peer's answer to its close frame. `protocols` are the\nsubprotocols the server speaks, in order of preference. `outgoing_queue` is how many messages `outgoing` holds (1 to\n1048576) before a send waits: the writer takes everything queued at that moment and writes it in one go."
      field: field-decl #124 10226:169:3-10259:170:1 name="max_message_bytes"
        type: type-ref #122 10245:169:22-10248:169:25 name="Int"
        default: literal #123 10251:169:28-10258:169:35 value=int:1048576
      field: field-decl #127 10261:170:3-10278:171:1 name="idle_ms"
        type: type-ref #125 10270:170:12-10273:170:15 name="Int"
        default: literal #126 10276:170:18-10277:170:19 value=int:0
      field: field-decl #130 10280:171:3-10297:172:1 name="ping_ms"
        type: type-ref #128 10289:171:12-10292:171:15 name="Int"
        default: literal #129 10295:171:18-10296:171:19 value=int:0
      field: field-decl #133 10299:172:3-10320:173:1 name="close_ms"
        type: type-ref #131 10309:172:13-10312:172:16 name="Int"
        default: literal #132 10315:172:19-10319:172:23 value=int:5000
      field: field-decl #137 10322:173:3-10351:174:1 name="protocols"
        type: type-ref #135 10333:173:14-10345:173:26 name="List"
          arg: type-ref #134 10338:173:19-10344:173:25 name="String"
        default: list-lit #136 10348:173:29-10350:173:31
      field: field-decl #140 10353:174:3-10377:175:1 name="outgoing_queue"
        type: type-ref #138 10369:174:19-10372:174:22 name="Int"
        default: literal #139 10375:174:25-10376:174:26 value=int:8
    declaration: enum-decl #149 10609:179:1-10714:183:1 name="@2::Upgrade" type-parameters=[] doc="What `accept_websocket` decides for a request, for an `Answer.Upgrade`: `Reply` answers it as a whole response (and\nthe connection serves the next request), `Accept` upgrades it. Make an `Accept` with `accept_websocket`."
      variant: enum-variant #143 10624:180:3-10649:181:1 name="Reply"
        payload: type-ref #142 10630:180:9-10647:180:26 name="HttpWire.Response"
      variant: enum-variant #148 10651:181:3-10710:182:1 name="Accept"
        payload: type-ref #144 10658:181:10-10674:181:26 name="@2::WebSocketSession"
        payload: type-ref #145 10676:181:28-10692:181:44 name="@2::WebSocketOptions"
        payload: type-ref #146 10694:181:46-10700:181:52 name="String"
        payload: type-ref #147 10702:181:54-10708:181:60 name="String"
    declaration: enum-decl #156 11032:187:1-11119:192:1 name="@2::Answer" type-parameters=[] doc="What an `App` returns for a request. `Whole` is a whole response, as a `Handler` returns. `Stream` is a response\nwhose body arrives on a channel. `Upgrade` is what `accept_websocket` makes: its\n`Accept` runs a WebSocket on the connection, and its `Reply` (a request that is no handshake) is sent as `Whole`."
      variant: enum-variant #151 11046:188:3-11071:189:1 name="Whole"
        payload: type-ref #150 11052:188:9-11069:188:26 name="HttpWire.Response"
      variant: enum-variant #153 11073:189:3-11096:190:1 name="Stream"
        payload: type-ref #152 11080:189:10-11094:189:24 name="@2::StreamResponse"
      variant: enum-variant #155 11098:190:3-11115:191:1 name="Upgrade"
        payload: type-ref #154 11106:190:11-11113:190:18 name="@2::Upgrade"
    declaration: type-alias-decl #162 11450:196:1-11511:197:1 name="@2::App" doc="The function that `serve` and `serve_tls` call for each request: the request with an empty `body`, the\n`RequestBody` that carries the body as it arrives, and the `Answer` out. A route that wants the body whole calls\n`read_all`; `app` makes an `App` from a `Handler`. A middleware is a function from an `App` to an `App`."
      target: type-ref #161 11461:196:12-11510:196:61 name="Fn"
        arg: type-ref #157 11464:196:15-11480:196:31 name="HttpWire.Request"
        arg: type-ref #158 11482:196:33-11493:196:44 name="@2::RequestBody"
        arg: type-ref #160 11495:196:46-11509:196:60 name="Result"
          arg: type-ref #159 11502:196:53-11508:196:59 name="@2::Answer"
    declaration: function-decl #193 13944:221:1-14237:228:1 name="@2::client" doc="Creates a client that keeps connections open and reuses them. `options` is optional and defaults to\n`HTTP.ClientOptions()`: a 30 s `timeout_ms` for the whole call, a 10 s `connect_timeout_ms` and a 300 s\n`read_timeout_ms` for each wait for body bytes (0 for none), a 30 s idle timeout, up to 4 connections, 1 MiB bodies,\nthe system CA certificates and no proxy\n(set `tls: some(context)` to use a client context of `TLS.client_context` instead of the system certificates).\n`connect_to` is an IP address (empty by default) that every connection goes to instead of resolving the host of the\nURL; `Host`, the TLS server name and the certificate check still use the host of the URL. It applies to every URL\nthat this client reaches, so use one client per host. It is an error for a host name or any spelling that is not\nthe strict form of an address (IPv4 `a.b.c.d` with no leading zero, IPv6 without brackets, not IPv4-mapped), and\ntogether with a proxy.\nEvery number in `options` must be positive, except `read_timeout_ms`, which is 0 (no limit) or positive;\n`max_connections` is at most 65536 and `max_body_bytes` at most 64 MiB, or the result is an error: `max_body_bytes`\nbounds the bodies held in memory (`get`, `post`, `request` and the response of `upload`), and a bigger body goes\nthrough `download`, `read_body` or `open`, which stream it with no limit. `timeout_ms` is\nthe whole call (the wait for a slot, the connect, the head and the body); `connect_timeout_ms` bounds the connect\n(DNS, TCP, the TLS handshake and a proxy `CONNECT`) inside it, and `read_timeout_ms` each wait for body\nbytes. With a `proxy` (`http://host:port`, an origin with no path) every `http://` request goes\nthrough that forward proxy in absolute form (`GET http://host/path HTTP/1.1`, `Host` still the target's), the\nconnections are pooled by the proxy. An `https://` request opens a `CONNECT host:port` tunnel through the proxy,\none per target, and speaks TLS inside it, verified against the target (a non-2xx answer to the `CONNECT` is an\nerror that names the proxy). A `proxy` that is not an `http://` origin is an error here. The user info of the\n`proxy` (`http://user:password@host:8080`, percent-decoded) is sent to the proxy as `Proxy-Authorization: Basic`,\nand a `407` from it is an error that names the proxy and not the credentials. Close the client with `close_client`."
      param: param #166 13955:221:12-14013:221:70 name="options"
        type: type-ref #164 13964:221:21-13986:221:43 name="HttpWire.ClientOptions"
        default: construct #165 13989:221:46-14013:221:70 type="HttpWire.ClientOptions"
      result: type-ref #168 14018:221:75-14041:221:98 name="Result"
        arg: type-ref #167 14025:221:82-14040:221:97 name="HttpWire.Client"
