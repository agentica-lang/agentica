          arg: type-ref #49 3863:75:17-3878:75:32 name="HttpWire.Header"
    declaration: struct-decl #65 4771:86:1-4886:92:1 name="@2::Stream" doc="A response whose body arrives on a channel, from `open`: the `status` and `headers` of the head, the `body` channel\nand the `done` task that feeds it. The task reads the connection and sends each piece (up to 64 KiB, never empty),\nand it closes the channel on every path, so the reader runs the usual receive loop until the closed error and then\nawaits `done`: `ok` means the body ended cleanly, an `error` says why it did not (a cut body, a timeout, a bad\nchunk). To stop early the reader closes the channel: the task's next `send` fails, it closes the connection and\n`done` is an `error`. That works only while data flows: on a quiet stream the task waits in its read until\n`read_timeout_ms` (for ever when it is 0), so the prompt stop is `Task.cancel(stream.done)`, which closes the\nconnection at once. The connection belongs to the task and is never reused."
      field: field-decl #54 4787:87:3-4799:88:1 name="status"
        type: type-ref #53 4795:87:11-4798:87:14 name="Int"
      field: field-decl #57 4801:88:3-4832:89:1 name="headers"
        type: type-ref #56 4810:88:12-4831:88:33 name="List"
          arg: type-ref #55 4815:88:17-4830:88:32 name="HttpWire.Header"
      field: field-decl #60 4834:89:3-4855:90:1 name="body"
        type: type-ref #59 4840:89:9-4854:89:23 name="Channel"
          arg: type-ref #58 4848:89:17-4853:89:22 name="Bytes"
      field: field-decl #64 4857:90:3-4882:91:1 name="done"
        type: type-ref #63 4863:90:9-4881:90:27 name="Task"
          arg: type-ref #62 4868:90:14-4880:90:26 name="Result"
            arg: type-ref #61 4875:90:21-4879:90:25 name="Void"
    declaration: struct-decl #78 5334:97:1-6359:112:1 name="@2::StreamResponse" doc="A response whose body is sent as it is produced: the `status` and `headers` of the head, and a `body` channel of\npieces. The handler returns it at once and a task it spawned sends the pieces and closes the channel at the end. The\nserver sends each piece as soon as it arrives and ends the body when the channel closes. When the client leaves, the\nserver closes the channel, so the producer's next `send` returns an error and it stops."
      field: field-decl #67 5451:99:3-5463:100:1 name="status" doc="The status, 200 to 599, and not 204 or 304 unless the body is already closed and empty."
        type: type-ref #66 5459:99:11-5462:99:14 name="Int"
      field: field-decl #70 5584:101:3-5615:102:1 name="headers" doc="The response headers. The server adds `Transfer-Encoding: chunked` or `Content-Length`: the handler sets neither."
        type: type-ref #69 5593:101:12-5614:101:33 name="List"
          arg: type-ref #68 5598:101:17-5613:101:32 name="HttpWire.Header"
      field: field-decl #73 5699:103:3-5720:104:1 name="body" doc="The pieces of the body, as `Bytes` of any content (an empty one is skipped)."
        type: type-ref #72 5705:103:9-5719:103:23 name="Channel"
          arg: type-ref #71 5713:103:17-5718:103:22 name="Bytes"
      field: field-decl #77 6326:110:3-6355:111:1 name="length" doc="The size of the whole body in bytes, when the handler knows it (a file). The head then says `Content-Length` and\nthe pieces go out as they are, with no chunk framing, so a client can show progress and a range answer can\nstream. The producer must send exactly that many bytes and then close the channel: a body that ends short, or\na piece that would pass the length, cuts the connection (the client sees an incomplete body), and a body that is\nclosed when the handler returns and has another size is a 500. Not for a 204 or a 304. `none` is the default: the\nbody is chunked."
        type: type-ref #75 6334:110:11-6347:110:24 name="Optional"
          arg: type-ref #74 6343:110:20-6346:110:23 name="Int"
        default: call #76 6350:110:27-6354:110:31 name="none" piped=false
    declaration: type-alias-decl #83 6534:115:1-6597:116:1 name="@2::Handler" doc="A route that takes the request whole: the request in, the whole response out. `app` makes an `App` from it. A\nmiddleware is a function from a `Handler` to a `Handler`."
      target: type-ref #82 6549:115:16-6596:115:63 name="Fn"
        arg: type-ref #79 6552:115:19-6568:115:35 name="HttpWire.Request"
        arg: type-ref #81 6570:115:37-6595:115:62 name="Result"
          arg: type-ref #80 6577:115:44-6594:115:61 name="HttpWire.Response"
    declaration: struct-decl #92 7179:122:1-7254:126:1 name="@2::RequestBody" doc="The body of a request as it arrives, on a channel, for an `App`: the `pieces` channel (`Bytes` of any content, up\nto 64 KiB each, never empty, a chunked body already decoded) and the `done` task that feeds it. The task closes the\nchannel on every path, so the app runs the usual receive loop until the closed error and then awaits `done`: `ok`\nmeans the body arrived whole, an `error` says why it did not (the client left, a bad chunk, a timeout, a body over\n`max_body_bytes`). An app that answers before the whole body arrived ends the connection after its answer."
      field: field-decl #87 7200:123:3-7223:124:1 name="pieces"
        type: type-ref #86 7208:123:11-7222:123:25 name="Channel"
          arg: type-ref #85 7216:123:19-7221:123:24 name="Bytes"
      field: field-decl #91 7225:124:3-7250:125:1 name="done"
        type: type-ref #90 7231:124:9-7249:124:27 name="Task"
          arg: type-ref #89 7236:124:14-7248:124:26 name="Result"
            arg: type-ref #88 7243:124:21-7247:124:25 name="Void"
    declaration: enum-decl #106 8053:134:1-8168:142:1 name="@2::Message" type-parameters=[] doc="A message of a WebSocket, in either direction. `Text` and `Binary` are whole messages: the server joins the\nfragments of a message it receives, and a text message is checked as UTF-8. `Ping` and `Pong` carry at most 125\nbytes. The server answers every ping it receives with a pong, and does not hand it to the handler. `Close` is the\nend: the code (1000 to 1003 and 1007 to 1014 are the registered codes, 3000 to 4999 are for programs) and a reason\nof at most 123 bytes. It is always the last message the handler receives, and when the connection ended with no\nclose frame (the peer left, a timeout) its code is 1006. `Prepared` is a text or binary message already framed by\n`prepare`, so a broadcast does not frame its message for every socket; the server never receives one."
      variant: enum-variant #94 8068:135:3-8081:136:1 name="Text"
        payload: type-ref #93 8073:135:8-8079:135:14 name="String"
      variant: enum-variant #96 8083:136:3-8097:137:1 name="Binary"
        payload: type-ref #95 8090:136:10-8095:136:15 name="Bytes"
      variant: enum-variant #98 8099:137:3-8111:138:1 name="Ping"
        payload: type-ref #97 8104:137:8-8109:137:13 name="Bytes"
      variant: enum-variant #100 8113:138:3-8125:139:1 name="Pong"
        payload: type-ref #99 8118:138:8-8123:138:13 name="Bytes"
      variant: enum-variant #103 8127:139:3-8146:140:1 name="Close"
        payload: type-ref #101 8133:139:9-8136:139:12 name="Int"
        payload: type-ref #102 8138:139:14-8144:139:20 name="String"
      variant: enum-variant #105 8148:140:3-8164:141:1 name="Prepared"
        payload: type-ref #104 8157:140:12-8162:140:17 name="Bytes"
    declaration: struct-decl #115 8860:149:1-8958:154:1 name="@2::WebSocket" doc="An upgraded connection, for the session function of `accept_websocket`: messages from the peer arrive on `incoming`\nand the messages to send go on `outgoing`. `protocol` is the subprotocol that was agreed, or \"\". Both channels hold\n8 messages, so a handler that does not read makes the server stop reading the socket, and a handler that sends\nfaster than the peer reads waits. A session must keep taking messages from `incoming` (or end): while it does not,\nthe server does not read the socket, so the pings and the close of the peer go unanswered. `incoming` closes after\nthe `Close` message, and `outgoing` closes when the connection is over, so a send then is an error."
      field: field-decl #109 8879:150:3-8906:151:1 name="incoming"
        type: type-ref #108 8889:150:13-8905:150:29 name="Channel"
          arg: type-ref #107 8897:150:21-8904:150:28 name="@2::Message"
      field: field-decl #112 8908:151:3-8935:152:1 name="outgoing"
        type: type-ref #111 8918:151:13-8934:151:29 name="Channel"
          arg: type-ref #110 8926:151:21-8933:151:28 name="@2::Message"
      field: field-decl #114 8937:152:3-8954:153:1 name="protocol"
        type: type-ref #113 8947:152:13-8953:152:19 name="String"
    declaration: type-alias-decl #120 9234:158:1-9286:159:1 name="@2::WebSocketSession" doc="The function that runs a WebSocket after its handshake: it gets the `WebSocket` and returns when it is done. When it\nreturns, the server sends a close frame (code 1000, or 1011 for an `error`) if the session did not, waits for the\npeer's, and closes the connection."
      target: type-ref #119 9258:158:25-9285:158:52 name="Fn"
        arg: type-ref #116 9261:158:28-9270:158:37 name="@2::WebSocket"
        arg: type-ref #118 9272:158:39-9284:158:51 name="Result"
          arg: type-ref #117 9279:158:46-9283:158:50 name="Void"
    declaration: struct-decl #141 10209:168:1-10390:176:1 name="@2::WebSocketOptions" doc="The limits of a WebSocket. `max_message_bytes` is the largest message, joined from its fragments (1 to 256 MiB): a\nlarger one closes the connection with code 1009. `idle_ms` is the longest the server waits for the peer to send\nanything, 0 for no limit but a year (a read that times out closes the socket); a timeout drops the connection, and\nthe handler receives `Close` with code 1006. `ping_ms` makes the server send a ping after that many milliseconds\nwithout anything to write, 0 for none: with a `ping_ms` below `idle_ms` the pongs keep a live peer from being\ndropped. `close_ms` is how long the server waits for the peer's answer to its close frame. `protocols` are the\nsubprotocols the server speaks, in order of preference. `outgoing_queue` is how many messages `outgoing` holds (1 to\n1048576) before a send waits: the writer takes everything queued at that moment and writes it in one go."
      field: field-decl #124 10235:169:3-10268:170:1 name="max_message_bytes"
        type: type-ref #122 10254:169:22-10257:169:25 name="Int"
        default: literal #123 10260:169:28-10267:169:35 value=int:1048576
      field: field-decl #127 10270:170:3-10287:171:1 name="idle_ms"
        type: type-ref #125 10279:170:12-10282:170:15 name="Int"
        default: literal #126 10285:170:18-10286:170:19 value=int:0
      field: field-decl #130 10289:171:3-10306:172:1 name="ping_ms"
        type: type-ref #128 10298:171:12-10301:171:15 name="Int"
        default: literal #129 10304:171:18-10305:171:19 value=int:0
      field: field-decl #133 10308:172:3-10329:173:1 name="close_ms"
        type: type-ref #131 10318:172:13-10321:172:16 name="Int"
        default: literal #132 10324:172:19-10328:172:23 value=int:5000
      field: field-decl #137 10331:173:3-10360:174:1 name="protocols"
        type: type-ref #135 10342:173:14-10354:173:26 name="List"
          arg: type-ref #134 10347:173:19-10353:173:25 name="String"
        default: list-lit #136 10357:173:29-10359:173:31
      field: field-decl #140 10362:174:3-10386:175:1 name="outgoing_queue"
        type: type-ref #138 10378:174:19-10381:174:22 name="Int"
        default: literal #139 10384:174:25-10385:174:26 value=int:8
    declaration: enum-decl #149 10618:179:1-10723:183:1 name="@2::Upgrade" type-parameters=[] doc="What `accept_websocket` decides for a request, for an `Answer.Upgrade`: `Reply` answers it as a whole response (and\nthe connection serves the next request), `Accept` upgrades it. Make an `Accept` with `accept_websocket`."
      variant: enum-variant #143 10633:180:3-10658:181:1 name="Reply"
