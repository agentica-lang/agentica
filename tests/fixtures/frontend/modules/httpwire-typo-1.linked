        value: try-expr #165 12934:211:3-12959:211:28
          operand: call #164 12938:211:7-12959:211:28 name="@2::check_client" piped=false
            arg: name-ref #163 12951:211:20-12958:211:27 name="options"
      body: expr-stmt #170 12963:213:3-12988:214:1
        value: try-expr #169 12963:213:3-12987:213:27
          operand: call #168 12967:213:7-12987:213:27 name="@2::check_proxy" piped=false
