    declaration: struct-decl #15 1136:24:1-1330:30:1 name="@2::DownloadOptions" doc="How far a download may go: a positive `timeout_ms` for the whole call, from the connect to the last byte\nwritten, and a positive `max_total_bytes` for the body, at most 256 MiB."
