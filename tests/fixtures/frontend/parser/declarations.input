import Util from "util"
import Shapes from "shapes"

## A choice.
enum Choice[T, U]
  ## First.
  First(T)
  Second(T, U)
  Third
  ## Last.
  Fourth(List[T])
end

struct Empty
end

enum Documented
  A
end

## Adds.
def add(a: Int, b: Int,) -> Int
  return a + b
end

def is_ok!() -> Void
end

private

## A point.
struct Point
  ## Across.
  x: Int
  y: Int
  ## Up, with an imported type.
  tag: Util.Tag
  items: List[Map[String, Int]]
end

enum Plain
  A
  B
end

def none() -> Void
end

def with_types(a: List[Int], b: Map[String, Shapes.Shape], c: Result[Int]) -> Result[List[Int]]
  return ok([])
end

