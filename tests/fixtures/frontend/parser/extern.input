extern "libm.so.6"
  ## The cosine.
  export def cos(x: C.Double) -> C.Double

  def labs(n: C.Long) -> C.Long
end

extern "/opt/lib/my peer.so"
  ## A connection.
  export resource Conn, free: peer_close
  def peer_open(path: C.String) -> Conn
  def peer(a: C.Int32, b: C.Bool, s: C.String) -> C.String
  def send(conn: Conn, data: C.Bytes, n: C.Int32) -> C.Pointer
  def tick() -> Void
  ## The narrow, unsigned and long integers.
  def peer_narrow(a: C.Int8, b: C.Int16, c: C.UInt8, d: C.UInt16, out e: C.UInt32, out f: C.Long) -> C.UInt8
  ## Runs on the compute pool.
  compute def crunch(n: C.Int64) -> C.Double
  ## Gives a connection and a count as out parameters.
  export def peer_accept(port: C.Int32, out conn: Conn, out count: C.Int64) -> C.Int32
  def peer_split(x: C.Double, out whole: C.Double) -> Void
  ## Variadic, under another C name.
  def peer_vsum(kinds: C.String, out n: C.Int32, ..., a: C.Int32, b: C.Double) -> C.Double = "peer_vmix"
  compute def peer_vnone(kinds: C.String, ...) -> C.Double = "peer_vmix"
  ## Freed by a C name that starts with a capital letter.
  resource Cap, free: PeerFree
  ## Freed through a function pointer that the call takes.
  resource Session, free: C.Function
  ## Through a C function pointer.
  def peer_at(fn: C.Function, x: C.Int32) -> C.Int32
  compute def session_open(fn: C.Function, path: C.String, out s: Session, free: C.Function) -> C.Int32
  def session_named(path: C.String, free: C.Function) -> Session
  ## A C struct passed by value.
  export struct Pair
    x: C.Int32
    y: C.Int32 = 0
  end
  struct Box
    ## The corner.
    at: Pair
    scale: C.Float
    on: C.Bool
    data: C.Pointer
  end
  def box_make(n: C.Int64) -> Box
  compute def box_area(fn: C.Function, b: Box, out area: C.Double) -> Box
end
