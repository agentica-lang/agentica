## Constants of a module, after the imports and before the types.

import Lib from "lib"
import {MAX} from "lib"
## The deepest nesting.
export MAX_DEPTH = 1000
export GREETING: String = "hello"
SECONDS = 60 * 60
NAMES = [
  "a",
  "b"
]
LEVELS: Map[String, Int] = {"x": 1, "y": 2}
## The words that start a block.
export KEYWORDS: Set[String] = Set.new(["if", "else"])
DOUBLED = [1, 2, 3].map do |n|
  n * 2
end
CONFIG = Config(port: 80, name: "x")
NEGATIVE = -1
FLAGS = [true, false, nil]
TEXT = "limit #{MAX_DEPTH}"

struct Config
  port: Int
  name: String
end

def main() -> Void
  puts(GREETING)
end
