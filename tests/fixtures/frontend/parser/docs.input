# A comment that is not a doc.

## An exported struct.
struct T
  ## Only field.
  a: Int
end

## An exported enum.
enum U
  A
end

## Documented module.

## A doc on a function.
def one() -> Void
end

private

## A struct.
struct S
  ## A field.
  a: Int
  # not a doc
  b: Int
  ## Another.
  c: Int
end

## An enum.
enum E
  ## A variant.
  A(Int)
  B
  ## Last variant.
  C
end

def plain() -> Void
  x = 1 ## trailing
end
