import Types from "../syntax/types"
import Model from "builtin_model"

ROWS: List[Model.Builtin] = [
  Model.Builtin(
    name: "Float.abs",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Float.abs",
    effects: [],
    description: "The absolute value; -0.0 gives 0.0 and NaN stays NaN.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.ceil",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Float.ceil",
    effects: [],
    description: "The least Int >= float; NaN, an infinity or a value outside Int halts, as in to_i!.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.clamp",
    parameters: [
      Model.Named(name: "float", type: Types.Type.Float),
      Model.Named(name: "min", type: Types.Type.Float),
      Model.Named(name: "max", type: Types.Type.Float),
    ],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Float.clamp",
    effects: [],
    description: "float limited to min..max; min > max or a NaN bound halts; a NaN float stays NaN.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.floor",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Float.floor",
    effects: [],
    description: "The greatest Int <= float; NaN, an infinity or a value outside Int halts, as in to_i!.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.from_bits",
    parameters: [Model.Named(name: "bits", type: Types.Type.Int)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Float.from_bits",
    effects: [],
    description: "Read the 64 bits of an Int as a binary64 Float; any NaN pattern gives NaN.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.from_bits32",
    parameters: [Model.Named(name: "bits", type: Types.Type.Int)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Float.from_bits32",
    effects: [],
    description: "Read 32 bits as a binary32 and widen it exactly; bits outside 0 to 4294967295 halt.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.round",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Float.round",
    effects: [],
    description: "The nearest Int, halves away from zero; NaN, an infinity or a value outside Int halts, as in to_i!.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.to_bits",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Float.to_bits",
    effects: [],
    description: "The 64 IEEE 754 binary64 bits as an Int; every NaN gives the canonical 9221120237041090560.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.to_bits32",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Float.to_bits32",
    effects: [],
    description: (
      "Round to binary32 (ties to even) and give its 32 bits as an Int from 0 to 4294967295; every NaN gives " +
      "2143289344."
    ),
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.to_i",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Result(Types.Type.Int),
    rule: Model.Rule.Plain,
    implementation: "Float.to_int",
    effects: [],
    description: "Truncate toward zero; NaN, infinity or overflow return an error.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.to_i!",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Float.to_int!",
    effects: [],
    description: "Truncate toward zero; halt on NaN, infinity or overflow.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Float.to_s",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.String,
    rule: Model.Rule.Plain,
    implementation: "String.from_float",
    effects: [],
    description: "Convert a Float to text.",
    alternatives: [],
  ),
]
