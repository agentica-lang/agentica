import Types from "../syntax/types"
import Model from "builtin_model"

ROWS: List[Model.Builtin] = [
  Model.Builtin(
    name: "Bytes.at",
    parameters: [Model.Named(name: "bytes", type: Types.Type.Bytes), Model.Named(name: "index", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Bytes.at",
    effects: [],
    description: "Read the byte at a zero-based index as an Int (0..255); an index outside the bytes halts.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.concat",
    parameters: [Model.Named(name: "list", type: Types.Type.List(Types.Type.Bytes))],
    result: Types.Type.Bytes,
    rule: Model.Rule.Plain,
    implementation: "Bytes.concat",
    effects: [],
    description: "Join the parts in order in one copy; prefer it to + in a loop.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.drop",
    parameters: [Model.Named(name: "bytes", type: Types.Type.Bytes), Model.Named(name: "count", type: Types.Type.Int)],
    result: Types.Type.Bytes,
    rule: Model.Rule.Plain,
    implementation: "Bytes.drop",
    effects: [],
    description: (
      "Copy the bytes after the first count; count above the length gives empty bytes, a negative count halts."
    ),
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.each",
    parameters: [
      Model.Named(name: "bytes", type: Types.Type.Bytes),
      Model.Named(name: "block", type: Types.Type.Fn([Types.Type.Int], Types.Type.Void)),
    ],
    result: Types.Type.Void,
    rule: Model.Rule.Prelude,
    implementation: "",
    effects: [],
    description: "Call block on each byte in order; returns nothing.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.empty?",
    parameters: [Model.Named(name: "bytes", type: Types.Type.Bytes)],
    result: Types.Type.Bool,
    rule: Model.Rule.Prelude,
    implementation: "",
    effects: [],
    description: "Check whether there are no bytes.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.from_list",
    parameters: [Model.Named(name: "list", type: Types.Type.List(Types.Type.Int))],
    result: Types.Type.Result(Types.Type.Bytes),
    rule: Model.Rule.Plain,
    implementation: "Bytes.from_list",
    effects: [],
    description: "Make bytes from a list of Ints; an item outside 0..255 gives an error with its index.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.length",
    parameters: [Model.Named(name: "bytes", type: Types.Type.Bytes)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Bytes.length",
    effects: [],
    description: "Count the bytes.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.slice",
    parameters: [
      Model.Named(name: "bytes", type: Types.Type.Bytes),
      Model.Named(name: "start", type: Types.Type.Int),
      Model.Named(name: "length", type: Types.Type.Int),
    ],
    result: Types.Type.Bytes,
    rule: Model.Rule.Plain,
    implementation: "Bytes.slice",
    effects: [],
    description: "Copy a byte range; halt outside bounds.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.take",
    parameters: [Model.Named(name: "bytes", type: Types.Type.Bytes), Model.Named(name: "count", type: Types.Type.Int)],
    result: Types.Type.Bytes,
    rule: Model.Rule.Plain,
    implementation: "Bytes.take",
    effects: [],
    description: "Copy the first count bytes; count above the length gives all of them, a negative count halts.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.to_a",
    parameters: [Model.Named(name: "bytes", type: Types.Type.Bytes)],
    result: Types.Type.List(Types.Type.Int),
    rule: Model.Rule.Plain,
    implementation: "Bytes.to_a",
    effects: [],
    description: "List the bytes as Ints (0..255); the way to map, select and the other List methods.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Bytes.decode",
    parameters: [
      Model.Named(name: "bytes", type: Types.Type.Bytes),
      Model.Named(name: "encoding", type: Types.Type.String),
    ],
    result: Types.Type.Result(Types.Type.String),
    rule: Model.Rule.Plain,
    implementation: "Bytes.decode",
    effects: [],
    description: "Read the bytes as text in an encoding; invalid bytes or an unknown encoding give an error.",
    alternatives: [],
  ),
]
