import Types from "../syntax/types"
import Model from "builtin_model"

ROWS: List[Model.Builtin] = [
  Model.Builtin(
    name: "TCP.accept",
    parameters: [
      Model.Named(name: "listener", type: Types.Type.Opaque("TCP.Listener")),
      Model.Named(name: "timeout_ms", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.Opaque("TCP.Socket")),
    rule: Model.Rule.Plain,
    implementation: "TCP.accept",
    effects: ["network"],
    description: "Accept a TCP or TLS connection.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "TCP.close",
    parameters: [Model.Named(name: "socket", type: Types.Type.Opaque("TCP.Socket"))],
    result: Types.Type.Void,
    rule: Model.Rule.Plain,
    implementation: "TCP.close",
    effects: ["network"],
    description: "Close a socket idempotently.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "TCP.close_listener",
    parameters: [Model.Named(name: "listener", type: Types.Type.Opaque("TCP.Listener"))],
    result: Types.Type.Void,
    rule: Model.Rule.Plain,
    implementation: "TCP.close_listener",
    effects: ["network"],
    description: "Close a listener idempotently.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "TCP.connect",
    parameters: [
      Model.Named(name: "host", type: Types.Type.String),
      Model.Named(name: "port", type: Types.Type.Int),
      Model.Named(name: "timeout_ms", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.Opaque("TCP.Socket")),
    rule: Model.Rule.Plain,
    implementation: "TCP.connect",
    effects: ["network"],
    description: "Connect to a TCP peer within a deadline.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "TCP.listen",
    parameters: [Model.Named(name: "host", type: Types.Type.String), Model.Named(name: "port", type: Types.Type.Int)],
    result: Types.Type.Result(Types.Type.Opaque("TCP.Listener")),
    rule: Model.Rule.Plain,
    implementation: "TCP.listen",
    effects: ["network"],
    description: "Listen on an address; port zero chooses a free port.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "TCP.local_port",
    parameters: [Model.Named(name: "listener", type: Types.Type.Opaque("TCP.Listener"))],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "TCP.local_port",
    effects: ["network"],
    description: "Return the actual listening port.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "TCP.remote_address",
    parameters: [Model.Named(name: "socket", type: Types.Type.Opaque("TCP.Socket"))],
    result: Types.Type.String,
    rule: Model.Rule.Plain,
    implementation: "TCP.remote_address",
    effects: ["network"],
    description: "Return the peer's IP address (\"127.0.0.1\", \"::1\") without the port, or \"\" when closed.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "TCP.read_line",
    parameters: [
      Model.Named(name: "socket", type: Types.Type.Opaque("TCP.Socket")),
      Model.Named(name: "timeout_ms", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.String),
    rule: Model.Rule.Plain,
    implementation: "TCP.read_line",
    effects: ["network"],
    description: "Read a bounded UTF-8 line, removing its terminator.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "TCP.recv_bytes",
    parameters: [
      Model.Named(name: "socket", type: Types.Type.Opaque("TCP.Socket")),
      Model.Named(name: "max_bytes", type: Types.Type.Int),
      Model.Named(name: "timeout_ms", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.Bytes),
    rule: Model.Rule.Plain,
    implementation: "TCP.recv_bytes.bytes",
    effects: ["network"],
    description: "Read available bytes; empty Bytes indicate EOF; a timeout closes the socket.",
    alternatives: [
      Model.Builtin(
        name: "TCP.recv_bytes",
        parameters: [
          Model.Named(name: "socket", type: Types.Type.Opaque("TCP.Socket")),
          Model.Named(name: "max_bytes", type: Types.Type.Int),
        ],
        result: Types.Type.Result(Types.Type.Bytes),
        rule: Model.Rule.Plain,
        implementation: "TCP.recv_bytes.bytes",
        effects: ["network"],
        description: "Read available bytes with no time limit; empty Bytes indicate EOF.",
        alternatives: [],
      ),
    ],
  ),
  Model.Builtin(
    name: "TCP.send",
    parameters: [
      Model.Named(name: "socket", type: Types.Type.Opaque("TCP.Socket")),
      Model.Named(name: "text", type: Types.Type.String),
      Model.Named(name: "timeout_ms", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.Void),
    rule: Model.Rule.Plain,
    implementation: "TCP.send",
    effects: ["network"],
    description: "Send UTF-8 text and flush.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "TCP.send_bytes",
    parameters: [
      Model.Named(name: "socket", type: Types.Type.Opaque("TCP.Socket")),
      Model.Named(name: "bytes", type: Types.Type.Bytes),
      Model.Named(name: "timeout_ms", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.Void),
    rule: Model.Rule.Plain,
    implementation: "TCP.send_bytes.bytes",
    effects: ["network"],
    description: "Send bytes and flush, at most 1 MiB per call.",
    alternatives: [],
  ),
]
