import Types from "../syntax/types"
import Model from "builtin_model"

ROWS: List[Model.Builtin] = [
  Model.Builtin(
    name: "Math.sqrt",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Math.sqrt",
    effects: [],
    description: "The square root; a negative float halts; -0.0 gives -0.0 and NaN stays NaN.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Math.exp",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Math.exp",
    effects: [],
    description: "e raised to float; -Infinity gives 0.0, and NaN stays NaN.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Math.log",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Math.log",
    effects: [],
    description: "The natural logarithm; a negative float halts, 0.0 gives -Infinity and NaN stays NaN.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Math.log10",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Math.log10",
    effects: [],
    description: "The base-10 logarithm; a negative float halts, 0.0 gives -Infinity and NaN stays NaN.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Math.sin",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Math.sin",
    effects: [],
    description: "The sine of float in radians; an infinity gives NaN.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Math.cos",
    parameters: [Model.Named(name: "float", type: Types.Type.Float)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Math.cos",
    effects: [],
    description: "The cosine of float in radians; an infinity gives NaN.",
    alternatives: [],
  ),
]
