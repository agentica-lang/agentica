  ),
  Model.Builtin(
    name: "Range.sum",
    parameters: [Model.Named(name: "range", type: Types.Type.Range)],
    result: Types.Type.Int,
    rule: Model.Rule.Prelude,
    implementation: "",
    effects: [],
    description: "Add the values; an empty range gives 0; Int overflow halts; O(n).",
