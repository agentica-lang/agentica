import Types from "../syntax/types"
import Model from "builtin_model"

ROWS: List[Model.Builtin] = [
  Model.Builtin(
    name: "Range.each",
    parameters: [
      Model.Named(name: "range", type: Types.Type.Range),
      Model.Named(name: "block", type: Types.Type.Fn([Types.Type.Int], Types.Type.Void)),
    ],
    result: Types.Type.Void,
    rule: Model.Rule.Plain,
    implementation: "Range.each",
    effects: [],
    description: "Call block on each value in order; returns nothing.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.first",
    parameters: [Model.Named(name: "range", type: Types.Type.Range)],
    result: Types.Type.Result(Types.Type.Int),
    rule: Model.Rule.Plain,
    implementation: "Range.first",
    effects: [],
    description: "The first value; an error for an empty range.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.include?",
