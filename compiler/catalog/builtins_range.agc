    rule: Model.Rule.Plain,
    implementation: "Range.include?",
    effects: [],
    description: "Check whether a value is in the range.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.lazy",
    parameters: [Model.Named(name: "range", type: Types.Type.Range)],
    result: Types.Type.Lazy(Types.Type.Int),
    rule: Model.Rule.Prelude,
    implementation: "",
    effects: [],
    description: "A Lazy over the range: steps run only in a terminal, one item at a time.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.last",
    parameters: [Model.Named(name: "range", type: Types.Type.Range)],
    result: Types.Type.Result(Types.Type.Int),
    rule: Model.Rule.Plain,
    implementation: "Range.last",
    effects: [],
    description: "The last included value; an error for an empty range.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.size",
    parameters: [Model.Named(name: "range", type: Types.Type.Range)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Range.size",
    effects: [],
    description: "Count the values; halts when the count does not fit in Int.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.to_a",
    parameters: [Model.Named(name: "range", type: Types.Type.Range)],
    result: Types.Type.List(Types.Type.Int),
    rule: Model.Rule.Plain,
    implementation: "Range.to_a",
    effects: [],
    description: "List the values in order; at most 1048576 values.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.all?",
    parameters: [
      Model.Named(name: "range", type: Types.Type.Range),
      Model.Named(name: "block", type: Types.Type.Fn([Types.Type.Int], Types.Type.Bool)),
    ],
    result: Types.Type.Bool,
    rule: Model.Rule.Prelude,
    implementation: "",
    effects: [],
    description: (
      "True when block accepts every value (true for an empty range); block stops at the first false; O(n)."
    ),
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.any?",
    parameters: [
      Model.Named(name: "range", type: Types.Type.Range),
      Model.Named(name: "block", type: Types.Type.Fn([Types.Type.Int], Types.Type.Bool)),
    ],
    result: Types.Type.Bool,
    rule: Model.Rule.Prelude,
    implementation: "",
    effects: [],
    description: "True when block accepts a value; block stops at the first true; O(n).",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.drop_while",
    parameters: [
      Model.Named(name: "range", type: Types.Type.Range),
      Model.Named(name: "block", type: Types.Type.Fn([Types.Type.Int], Types.Type.Bool)),
    ],
    result: Types.Type.List(Types.Type.Int),
    rule: Model.Rule.Prelude,
    implementation: "",
    effects: [],
    description: "List the values from the first one block rejects on; block is not called after it; O(n).",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.each_slice",
    parameters: [Model.Named(name: "range", type: Types.Type.Range), Model.Named(name: "size", type: Types.Type.Int)],
    result: Types.Type.List(Types.Type.List(Types.Type.Int)),
    rule: Model.Rule.Prelude,
    implementation: "",
    effects: [],
    description: "Split into lists of size values, the last one shorter; size below 1 halts; O(n).",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Range.each_with_index",
    parameters: [
      Model.Named(name: "range", type: Types.Type.Range),
