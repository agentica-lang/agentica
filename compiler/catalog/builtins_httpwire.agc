    rule: Model.Rule.Plain,
    implementation: "HttpWire.accept",
    effects: ["network"],
    description: "Internal to std/http: wait for a free slot and the next connection.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "HttpWire.awaited?",
