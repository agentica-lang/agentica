    ],
    result: Types.Type.Result(Types.Type.String),
    rule: Model.Rule.Plain,
    implementation: "HttpWire.encode_request",
    effects: [],
    description: (
      "Internal to std/http: the text of a request head with Host and Content-Length, or the reason the " +
