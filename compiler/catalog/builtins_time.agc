    ),
    alternatives: [],
  ),
  Model.Builtin(
    name: "Time.now",
    parameters: [],
    result: Types.Type.Struct("Time.DateTime", []),
    rule: Model.Rule.Plain,
    implementation: "Time.now",
    effects: ["clock"],
    description: "Read the wall clock as a Time.DateTime in UTC, to the microsecond; may jump.",
