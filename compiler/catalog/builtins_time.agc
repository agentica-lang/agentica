import Types from "../syntax/types"
import Model from "builtin_model"

ROWS: List[Model.Builtin] = [
  Model.Builtin(
    name: "Time.Date.days_in_month",
    parameters: [Model.Named(name: "year", type: Types.Type.Int), Model.Named(name: "month", type: Types.Type.Int)],
    result: Types.Type.Result(Types.Type.Int),
    rule: Model.Rule.Plain,
    implementation: "Time.Date.days_in_month",
    effects: [],
    description: "Return the days of a month, 28 to 31; an error outside the years 1 to 9999 or the months 1 to 12.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Time.Date.leap?",
    parameters: [Model.Named(name: "year", type: Types.Type.Int)],
    result: Types.Type.Bool,
    rule: Model.Rule.Plain,
    implementation: "Time.Date.leap?",
    effects: [],
    description: "Whether a year has 366 days in the proleptic Gregorian calendar; any Int year.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Time.Date.new",
    parameters: [
      Model.Named(name: "year", type: Types.Type.Int),
      Model.Named(name: "month", type: Types.Type.Int),
      Model.Named(name: "day", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.Struct("Time.Date", [])),
    rule: Model.Rule.Plain,
    implementation: "Time.Date.new",
    effects: [],
    description: "Build a date; an error when it is no real day of the years 1 to 9999.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Time.DateTime.new",
    parameters: [
      Model.Named(name: "year", type: Types.Type.Int),
      Model.Named(name: "month", type: Types.Type.Int),
      Model.Named(name: "day", type: Types.Type.Int),
      Model.Named(name: "hour", type: Types.Type.Int),
      Model.Named(name: "min", type: Types.Type.Int),
      Model.Named(name: "sec", type: Types.Type.Int),
      Model.Named(name: "usec", type: Types.Type.Int),
      Model.Named(name: "utc_offset", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.Struct("Time.DateTime", [])),
    rule: Model.Rule.Plain,
    implementation: "Time.DateTime.new",
    effects: [],
    description: (
      "Build a date and time at utc_offset seconds east of UTC, whole minutes within a day; an error when a field " +
      "is out of range."
    ),
    alternatives: [],
  ),
  Model.Builtin(
    name: "Time.NaiveDateTime.new",
    parameters: [
      Model.Named(name: "year", type: Types.Type.Int),
      Model.Named(name: "month", type: Types.Type.Int),
      Model.Named(name: "day", type: Types.Type.Int),
      Model.Named(name: "hour", type: Types.Type.Int),
      Model.Named(name: "min", type: Types.Type.Int),
      Model.Named(name: "sec", type: Types.Type.Int),
      Model.Named(name: "usec", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.Struct("Time.NaiveDateTime", [])),
    rule: Model.Rule.Plain,
    implementation: "Time.NaiveDateTime.new",
    effects: [],
    description: "Build a date and time with no offset; an error when a field is out of range.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Time.TimeOfDay.new",
    parameters: [
      Model.Named(name: "hour", type: Types.Type.Int),
      Model.Named(name: "min", type: Types.Type.Int),
      Model.Named(name: "sec", type: Types.Type.Int),
      Model.Named(name: "usec", type: Types.Type.Int),
    ],
    result: Types.Type.Result(Types.Type.Struct("Time.TimeOfDay", [])),
    rule: Model.Rule.Plain,
    implementation: "Time.TimeOfDay.new",
    effects: [],
    description: "Build a time of day from hour, min, sec and usec; an error when a field is out of range.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Time.monotonic_ms",
    parameters: [],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Time.monotonic_ms",
    effects: ["clock"],
    description: "Read milliseconds from an arbitrary origin that never goes backward; use for durations.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Time.monotonic_ns",
    parameters: [],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Time.monotonic_ns",
    effects: ["clock"],
    description: (
      "Read nanoseconds from the clock of Time.monotonic_ms; same origin, never goes backward; use for short " +
      "durations."
    ),
    alternatives: [],
  ),
  Model.Builtin(
    name: "Time.now_ms",
    parameters: [],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Time.now_ms",
    effects: ["clock"],
    description: "Read wall-clock milliseconds since the Unix epoch; may jump.",
    alternatives: [],
  ),
]
