        result: Types.Type.Int,
        rule: Model.Rule.Plain,
        implementation: "String.edit_distance",
        effects: [],
        description: (
          "The Levenshtein distance, or max + 1 once it passes max, with about n * (2 * max + 1) table cells of " +
