import Types from "../syntax/types"
import Model from "builtin_model"

ROWS: List[Model.Builtin] = [
  Model.Builtin(
    name: "Int.to_f",
    parameters: [Model.Named(name: "int", type: Types.Type.Int)],
    result: Types.Type.Float,
    rule: Model.Rule.Plain,
    implementation: "Float.from_int",
    effects: [],
    description: "Convert an Int to the nearest Float.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.abs",
    parameters: [Model.Named(name: "int", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.abs",
    effects: [],
    description: "The absolute value; the least Int halts with an overflow.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.bit_and",
    parameters: [Model.Named(name: "int", type: Types.Type.Int), Model.Named(name: "other", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.bit_and",
    effects: [],
    description: "Bitwise and of the 64-bit two's complement forms.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.bit_not",
    parameters: [Model.Named(name: "int", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.bit_not",
    effects: [],
    description: "Flip every bit; the same as -1 - int.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.bit_or",
    parameters: [Model.Named(name: "int", type: Types.Type.Int), Model.Named(name: "other", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.bit_or",
    effects: [],
    description: "Bitwise or of the 64-bit two's complement forms.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.bit_xor",
    parameters: [Model.Named(name: "int", type: Types.Type.Int), Model.Named(name: "other", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.bit_xor",
    effects: [],
    description: "Bitwise exclusive or of the 64-bit two's complement forms.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.clamp",
    parameters: [
      Model.Named(name: "int", type: Types.Type.Int),
      Model.Named(name: "min", type: Types.Type.Int),
      Model.Named(name: "max", type: Types.Type.Int),
    ],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.clamp",
    effects: [],
    description: "int limited to min..max; min > max halts.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.downto",
    parameters: [
      Model.Named(name: "from", type: Types.Type.Int),
      Model.Named(name: "to", type: Types.Type.Int),
      Model.Named(name: "block", type: Types.Type.Fn([Types.Type.Int], Types.Type.Void)),
    ],
    result: Types.Type.Void,
    rule: Model.Rule.Plain,
    implementation: "Int.downto",
    effects: [],
    description: "Call block with from down to to; nothing when to > from.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.gcd",
    parameters: [Model.Named(name: "int", type: Types.Type.Int), Model.Named(name: "other", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.gcd",
    effects: [],
    description: "The greatest common divisor, never negative; gcd of 0 and 0 is 0; a result of 2^63 halts.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.pow",
    parameters: [Model.Named(name: "int", type: Types.Type.Int), Model.Named(name: "exponent", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.pow",
    effects: [],
    description: "int to the power exponent; a negative exponent or an overflow halts.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.shift_left",
    parameters: [Model.Named(name: "int", type: Types.Type.Int), Model.Named(name: "count", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.shift_left",
    effects: [],
    description: (
      "Shift bits left; bits that leave the top are dropped, so it wraps; a count of 64 or more gives 0; a " +
      "negative count halts."
    ),
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.shift_right",
    parameters: [Model.Named(name: "int", type: Types.Type.Int), Model.Named(name: "count", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.shift_right",
    effects: [],
    description: (
      "Arithmetic shift right, copying the sign bit; a count of 64 or more gives 0 or -1; a negative count halts."
    ),
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.shift_right_unsigned",
    parameters: [Model.Named(name: "int", type: Types.Type.Int), Model.Named(name: "count", type: Types.Type.Int)],
    result: Types.Type.Int,
    rule: Model.Rule.Plain,
    implementation: "Int.shift_right_unsigned",
    effects: [],
    description: "Logical shift right, bringing in zeros; a count of 64 or more gives 0; a negative count halts.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.times",
    parameters: [
      Model.Named(name: "int", type: Types.Type.Int),
      Model.Named(name: "block", type: Types.Type.Fn([Types.Type.Int], Types.Type.Void)),
    ],
    result: Types.Type.Void,
    rule: Model.Rule.Plain,
    implementation: "Int.times",
    effects: [],
    description: "Call block with 0 to int - 1; nothing when int <= 0.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.upto",
    parameters: [
      Model.Named(name: "from", type: Types.Type.Int),
      Model.Named(name: "to", type: Types.Type.Int),
      Model.Named(name: "block", type: Types.Type.Fn([Types.Type.Int], Types.Type.Void)),
    ],
    result: Types.Type.Void,
    rule: Model.Rule.Plain,
    implementation: "Int.upto",
    effects: [],
    description: "Call block with from up to to; nothing when to < from.",
    alternatives: [],
  ),
  Model.Builtin(
    name: "Int.to_s",
    parameters: [Model.Named(name: "int", type: Types.Type.Int)],
    result: Types.Type.String,
    rule: Model.Rule.Plain,
    implementation: "String.from_int",
    effects: [],
    description: "Convert an Int to text.",
    alternatives: [],
  ),
]
