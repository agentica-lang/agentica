#lang racket/base

;; Writes compiler/check_tables.agc: the method tables and the help texts of src/checker.rkt (method-modules,
;; method-aliases, foreign-names, foreign-methods, foreign-kind-methods) as Agentica data. The tool reads the
;; definitions from the source of src/checker.rkt and evaluates them, so the file cannot differ from the
;; tables the Racket checker uses; a test compares the file with check-tables-source.

(require racket/file
         racket/list
         racket/port
         racket/runtime-path
         racket/string)

(provide check-tables-source)

(define-runtime-path checker-source "../src/checker.rkt")
(define-runtime-path output "../compiler/check_tables.agc")

(define table-names
  '(method-modules method-aliases foreign-names foreign-methods foreign-kind-methods))

;; The strings that foreign-kind-methods shares between its entries.
(define shared-names '(no-regex-help split-help slice-help digit-help))

(define (source-forms)
  (with-input-from-file checker-source
    (lambda ()
      (read-line)
      (let loop ([forms '()])
        (define form (read))
        (if (eof-object? form) (reverse forms) (loop (cons form forms)))))))

;; The value of each table, found by evaluating its definition (and the shared strings it uses).
(define (evaluate-tables)
  (define namespace (make-base-namespace))
  (for ([form (in-list (source-forms))]
        #:when (and (pair? form) (eq? (car form) 'define) (symbol? (cadr form))
                    (memq (cadr form) (append table-names shared-names))))
    (eval form namespace))
  (for/hash ([name (in-list table-names)])
    (values name (eval name namespace))))

;; "#{" inside an Agentica string starts an interpolation; "\#" writes a literal "#".
(define (quoted text)
  (regexp-replace* #rx"#[{]" (format "~s" text) "\\\\#{"))

(define (string-key key)
  (if (pair? key)
      (format "~a.~a" (car key) (cdr key))
      key))

(define (sorted-pairs table)
  (sort (for/list ([(key value) (in-hash table)]) (cons (string-key key) value))
        string<? #:key car))

(define (map-literal table render-value)
  (string-append
   "{\n"
   (string-join (for/list ([entry (in-list (sorted-pairs table))])
                  (format "    ~a: ~a" (quoted (car entry)) (render-value (cdr entry))))
                ",\n")
   "\n  }"))

(define (table-function doc name type render-value table)
  (format "## ~a\nexport def ~a() -> ~a\n  return ~a\nend\n" doc name type (map-literal table render-value)))

(define (check-tables-source)
  (define tables (evaluate-tables))
  (define (text value) (if (symbol? value) (quoted (symbol->string value)) (quoted value)))
  (define modules
    (for/hash ([(kind module) (in-hash (hash-ref tables 'method-modules))])
      (values (symbol->string kind) module)))
  (string-join
   (list
    (string-append
     "## The method tables and help texts of src/checker.rkt as data. Generated by tools/gen-check-tables.rkt from the definitions in src/checker.rkt: change them there and run the tool, never edit this file by hand (a test checks it). A key `Kind.name` pairs the kind of the receiver (String, List, ...) with a method name.\n")
    (table-function "The builtin module that holds the methods of each receiver kind." "method_modules" "Map[String, String]" text modules)
    (table-function "The method names that are another builtin; `self` means the method returns the receiver." "method_aliases" "Map[String, String]" text (hash-ref tables 'method-aliases))
    (table-function "The help for a name used as a function or type that another language has." "foreign_names" "Map[String, String]" text (hash-ref tables 'foreign-names))
    (table-function "The Agentica methods that a foreign method name stands for." "foreign_methods" "Map[String, List[String]]"
                    (lambda (names) (string-append "[" (string-join (map quoted names) ", ") "]"))
                    (hash-ref tables 'foreign-methods))
    (table-function "The help for a method another language has, by receiver kind." "foreign_kind_methods" "Map[String, String]" text (hash-ref tables 'foreign-kind-methods)))
   "\n"))

(module+ main
  (display-to-file (check-tables-source) output #:exists 'truncate/replace))
