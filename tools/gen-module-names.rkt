#lang racket/base

;; Writes compiler/module_names.agc: the names the module linker takes from the
;; builtin tables of src/ (the 7.2.7 data rows). A test compares the file with
;; module-names-source, so a new builtin row or reserved name shows up there.

(require racket/file
         racket/list
         racket/runtime-path
         racket/string
         "../src/builtins.rkt"
         "../src/builtin-types.rkt"
         "../src/checker.rkt")

(provide module-names-source)

(define-runtime-path output "../compiler/module_names.agc")

(define (quoted text) (format "~s" text))

(define (string-list names)
  (string-append "[" (string-join (map quoted names) ", ") "]"))

;; The builtins that are plain names (puts, ok, ...): a declaration may not take one, and a call of one is left alone.
(define (bare-builtin-names)
  (sort (for/list ([name (in-list (hash-keys builtins))] #:unless (regexp-match? #rx"[.]" name)) name)
        string<?))

(define (module-names-source)
  (define std-only
    (for/list ([name (in-list std-only-modules)])
      (define import (hash-ref std-only-imports name))
      (format "~a: ~a" (quoted name) (string-list (list (car import) (cdr import))))))
  (string-append
   "## The names the module linker takes from the builtin tables of src/. Generated by tools/gen-module-names.rkt: change src/ and run the tool, never edit this file by hand (a test checks it).\n\n"
   "## The type names no declaration or import alias may take.\n"
   "export def reserved_type_names() -> List[String]\n"
   "  return " (string-list (sort reserved-type-names string<?)) "\n"
   "end\n\n"
   "## The builtins written as a plain name, such as puts and ok.\n"
   "export def bare_builtin_names() -> List[String]\n"
   "  return " (string-list (bare-builtin-names)) "\n"
   "end\n\n"
   "## The builtin enums, whose variants are written without an import.\n"
   "export def builtin_enum_names() -> List[String]\n"
   "  return " (string-list (sort (hash-keys builtin-enums) string<?)) "\n"
   "end\n\n"
   "## The modules only std/ may call: each name with the std module that wraps it and the alias its help shows.\n"
   "export def std_only_imports() -> Map[String, List[String]]\n"
   "  return {" (string-join std-only ", ") "}\n"
   "end\n"))

(module+ main
  (display-to-file (module-names-source) output #:exists 'truncate/replace))
