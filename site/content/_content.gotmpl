{{- /*
The language specification at /reference/: an index section and one page per file of docs/grammar/. The files are not under content/, so this adapter adds the pages. Each page keeps its file's text, with the links between parts rewritten to the pages. A page's title is its short title from $info, else the file's first heading without its section number; that heading is removed from the body, so no heading shows twice. A link to a removed heading goes to the page top. Weights follow the sorted file names, so the sidebar and the pager read the parts in order.
*/ -}}
{{- $parts := sort (resources.Match "grammar/*.md") "Name" -}}
{{- if lt (len $parts) 10 -}}
  {{- errorf "the language specification: expected the 10 files of docs/grammar/, found %d" (len $parts) -}}
{{- end -}}
{{- $info := dict
  "lexical" (dict "title" "Lexical conventions" "description" "The source text: encoding, comments, doc comments, literals and heredocs.")
  "syntax" (dict "title" "Syntax" "description" "The grammar in EBNF, with the statements and the precedence of expressions.")
  "modules" (dict "title" "Modules" "description" "File modules, imports and re-exports, constants, and packages.")
  "semantics" (dict "title" "Semantics" "description" "Types, scope, functions, pattern matching, generics and the collections.")
  "builtins" (dict "title" "Builtins" "description" "Methods and functions of the builtin types, JSON and the bytecode cache.")
  "tasks-and-tests" (dict "title" "Tasks and tests" "description" "Lightweight tasks, channels, shared tables, and unit tests.")
  "io-and-network" (dict "title" "I/O and network" "description" "TCP, TLS and HTTP, logging, files and paths, processes and native code.")
  "diagnostics" (dict "title" "Diagnostics" "description" "The format of each error, and the stable codes that agents rely on.")
  "examples" (dict "title" "Examples" "description" "Example programs that show the design, and programs that must be rejected.")
  "overview" (dict "title" "Overview" "description" "The purpose of the language, its design decisions and a core program.")
-}}
{{- $metas := slice -}}
{{- range $parts -}}
  {{- $stem := strings.TrimSuffix ".md" (path.Base .Name) -}}
  {{- $slug := replaceRE `^[0-9]+[a-z]?-` "" $stem -}}
  {{- $head := "" -}}
  {{- with findRESubmatch `(?m)\A\s*#{1,6}[ \t]+(.+?)[ \t]*$` .Content -}}
    {{- $head = index . 0 1 -}}
  {{- end -}}
  {{- $entry := index $info $slug | default (dict) -}}
  {{- $title := or $entry.title (replaceRE `^[0-9]+[a-z]?\.[ \t]+` "" $head) $slug -}}
  {{- $removed := replace (replaceRE `[^a-z0-9 _-]` "" (lower $head)) " " "-" -}}
  {{- $metas = $metas | append (dict "stem" $stem "slug" $slug "title" $title "removed" $removed) -}}
{{- end -}}
{{- range $i, $part := $parts -}}
  {{- $m := index $metas $i -}}
  {{- $meta := index $info $m.slug | default (dict) -}}
  {{- $text := replaceRE `\A\s*#{1,6}[ \t]+.*(\n|\z)` "" $part.Content 1 -}}
  {{- range $metas -}}
    {{- $text = replaceRE (printf `\]\((?:\./)?%s\.md(#[^)\s]*)?\)` .stem) (printf "](/reference/%s/${1})" .slug) $text -}}
  {{- end -}}
  {{- range $metas -}}
    {{- $t := . -}}
    {{- with $t.removed -}}
      {{- $text = replace $text (printf "](/reference/%s/#%s)" $t.slug .) (printf "](/reference/%s/)" $t.slug) -}}
      {{- $text = replace $text (printf "](#%s)" .) (printf "](/reference/%s/)" $t.slug) -}}
    {{- end -}}
  {{- end -}}
  {{- $text = replaceRE `\]\((?:\.\./){2}site/content/library/([a-z0-9-]+)/([a-z0-9-]+)\.md(#[^)\s]*)?\)` `](/library/${1}/${2}/${3})` $text -}}
  {{- $.AddPage (dict "path" (printf "reference/%s" $m.slug) "title" $m.title "description" $meta.description "weight" (add $i 1) "content" (dict "mediaType" "text/markdown" "value" $text)) -}}
{{- end -}}
