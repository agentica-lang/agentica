{
  "path": ["vm", "tests"],
  "format": ["c", "c-header", "python"],
  "ignore": [
    "**/third_party/**",
    "**/unicode_data.c",
    "vm/tools/**",
    "**/eval/tasks/**"
  ],
  "ignorePattern": ["\"\"\"[\\s\\S]*?\"\"\""],
  "minTokens": 50,
  "minLines": 5,
  "mode": "weak",
  "reporters": ["console"]
}
