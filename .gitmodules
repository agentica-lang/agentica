[submodule "vm/third_party/bdwgc"]
	path = vm/third_party/bdwgc
	url = https://github.com/ivmai/bdwgc.git
[submodule "vm/third_party/yyjson"]
	path = vm/third_party/yyjson
	url = https://github.com/ibireme/yyjson.git
[submodule "vm/third_party/libuv"]
	path = vm/third_party/libuv
	url = https://github.com/libuv/libuv.git
[submodule "vm/third_party/openssl"]
	path = vm/third_party/openssl
	url = https://github.com/openssl/openssl.git
	shallow = true
[submodule "vm/third_party/picohttpparser"]
	path = vm/third_party/picohttpparser
	url = https://github.com/h2o/picohttpparser.git
[submodule "vm/third_party/libffi"]
	path = vm/third_party/libffi
	url = https://github.com/libffi/libffi.git
[submodule "vm/third_party/zlib"]
	path = vm/third_party/zlib
	url = https://github.com/madler/zlib.git
